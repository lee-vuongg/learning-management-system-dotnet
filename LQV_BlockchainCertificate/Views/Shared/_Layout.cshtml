<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EduCert Blockchain</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --s4-blue: #1976d2;
            --s4-dark: #0f172a;
            --tet-red: #d63031;
            --navbar-height: 90px;
            --sakura-pink: #ffb7c5;
            --glass-bg: rgba(255, 255, 255, 0.75);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #ffffff;
            color: #1e293b;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* --- NAVBAR HIỆN ĐẠI --- */
        .navbar {
            height: var(--navbar-height);
            background: var(--glass-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1050;
        }

            .navbar.scrolled {
                height: 75px;
                background: rgba(255, 255, 255, 0.95);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            }

        .logo-img {
            height: 50px;
            width: auto;
            transition: all 0.4s ease;
        }

        .navbar.scrolled .logo-img {
            height: 42px;
        }

        .nav-link {
            font-weight: 600;
            color: var(--s4-dark) !important;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            padding: 0.5rem 1.2rem !important;
            transition: 0.3s;
            position: relative;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                width: 0;
                height: 2px;
                background: var(--s4-blue);
                transition: 0.3s;
                transform: translateX(-50%);
            }

            .nav-link:hover::after {
                width: 60%;
            }

            .nav-link:hover {
                color: var(--s4-blue) !important;
            }

        /* NÚT BẤM AUTH */
        .btn-auth {
            border-radius: 12px;
            padding: 10px 24px;
            font-weight: 700;
            font-size: 0.85rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-login {
            color: var(--s4-dark);
            background: transparent;
            border: 2px solid rgba(15, 23, 42, 0.1);
        }

            .btn-login:hover {
                background: var(--s4-dark);
                color: white !important;
                border-color: var(--s4-dark);
            }

        .btn-start {
            background: var(--s4-blue);
            color: white !important;
            box-shadow: 0 4px 15px rgba(25, 118, 210, 0.3);
            border: none;
        }

            .btn-start:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(25, 118, 210, 0.4);
                background: #1565c0;
            }

        /* --- FOOTER SANG TRỌNG --- */
        footer {
            background: #020617;
            color: #94a3b8;
            padding: 80px 0 30px;
            position: relative;
            margin-top: 100px;
        }

            footer::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, var(--s4-blue), var(--tet-red), var(--s4-blue));
            }

        .footer-title {
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .footer-link {
            color: #94a3b8;
            text-decoration: none;
            margin-bottom: 12px;
            display: block;
            transition: 0.3s;
            font-size: 0.95rem;
        }

            .footer-link:hover {
                color: var(--sakura-pink);
                transform: translateX(5px);
            }

        .newsletter-box {
            background: rgba(255, 255, 255, 0.03);
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .social-circle {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 10px;
            transition: 0.3s;
            text-decoration: none;
        }

            .social-circle:hover {
                background: var(--s4-blue);
                color: white;
                transform: translateY(-3px);
            }

        .copyright-area {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: 60px;
            padding-top: 30px;
            font-size: 0.85rem;
        }

        main {
            min-height: 75vh;
            padding-top: var(--navbar-height);
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/img/logo.png" class="logo-img me-2" alt="EduCert Logo" />
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">TRANG CHỦ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Certificate" asp-action="Verify">XÁC THỰC SỐ</a>
                    </li>
                    @* <li class="nav-item">
                        <a class="nav-link" href="#skill-map">SKILL MAP</a>
                    </li> *@
                    <li class="nav-item">
                        <a class="nav-link" href="#solutions">GIẢI PHÁP</a>
                    </li>
                </ul>
                <div class="d-flex gap-2 align-items-center">
                    <a class="btn btn-auth btn-login" asp-area="Auth" asp-controller="Account" asp-action="Login">ĐĂNG NHẬP</a>
                    <a class="btn btn-auth btn-start" asp-area="Auth" asp-controller="Account" asp-action="Register">
                        BẮT ĐẦU <i class="fas fa-rocket ms-1 small"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main role="main">
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-12">
                    <img src="~/img/logo.png" class="mb-4" style="height: 45px; filter: brightness(0) invert(1);" />
                    <p class="mb-4 pe-lg-5">
                        Ứng dụng Blockchain tiên phong bảo vệ sự minh bạch trong giáo dục.
                        Cùng bạn kiến tạo lộ trình kỹ năng bền vững trong kỷ nguyên số <b>Bính Ngọ 2026</b>.
                    </p>
                    <div class="d-flex">
                        <a href="#" class="social-circle"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-circle"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="social-circle"><i class="fab fa-github"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-6">
                    <h5 class="footer-title">Hệ thống</h5>
                    <nav class="d-flex flex-column">
                        <a href="#" class="footer-link">Skill Map</a>
                        <a href="#" class="footer-link">Verify Certificate</a>
                        <a href="#" class="footer-link">API Integration</a>
                        <a href="#" class="footer-link">Smart Contracts</a>
                    </nav>
                </div>

                <div class="col-lg-2 col-6">
                    <h5 class="footer-title">Hỗ trợ</h5>
                    <nav class="d-flex flex-column">
                        <a href="#" class="footer-link">Hướng dẫn sử dụng</a>
                        <a href="#" class="footer-link">Điều khoản Web3</a>
                        <a href="#" class="footer-link">Bảo mật dữ liệu</a>
                        <a href="#" class="footer-link">Liên hệ</a>
                    </nav>
                </div>

                <div class="col-lg-4">
                    <div class="newsletter-box">
                        <h5 class="footer-title">Newsletter</h5>
                        <p class="small mb-3">Nhận cập nhật về công nghệ Blockchain mới nhất.</p>
                        <div class="input-group">
                            <input type="email" class="form-control border-0 bg-white bg-opacity-10 text-white shadow-none"
                                   placeholder="Email của bạn..." style="border-radius: 10px 0 0 10px;">
                            <button class="btn btn-primary px-3" type="button" style="border-radius: 0 10px 10px 0;">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="copyright-area">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <p class="mb-0 opacity-50">© 2026 EduCert Project. Tự hào phát triển tại Việt Nam.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                        <span class="me-3 opacity-50 small">Powered by Ethereum</span>
                        <img src="https://cryptologos.cc/logos/ethereum-eth-logo.svg?v=024" width="18" class="opacity-50" />
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        // Khởi tạo hiệu ứng cuộn AOS
        AOS.init({
            duration: 800,
            once: true,
            offset: 50
        });

        // Xử lý thanh Navbar khi cuộn chuột
        window.addEventListener('scroll', function() {
            const nav = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>