@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Tra cứu chứng chỉ Blockchain";
}

<style>
    :root {
        --s4-primary: #007bff;
        --s4-dark: #2d3748;
        --s4-bg: #f8f9fa;
    }

    body {
        background-color: var(--s4-bg);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .search-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        padding: 40px;
        border: none;
    }

    .btn-s4-primary {
        background-color: var(--s4-primary);
        border: none;
        font-weight: 600;
        padding: 12px 25px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-s4-primary:hover {
            background-color: #0056b3;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0,123,255,0.3);
        }

    .form-control-s4 {
        border-radius: 8px;
        padding: 12px 15px;
        border: 1px solid #e2e8f0;
        transition: border-color 0.2s;
    }

        .form-control-s4:focus {
            border-color: var(--s4-primary);
            box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
        }

    .search-icon {
        font-size: 2.5rem;
        color: var(--s4-primary);
        margin-bottom: 20px;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="search-card text-center">
                <div class="search-icon">🔍</div>
                <h3 class="fw-bold mb-2" style="color: var(--s4-dark);">Tra cứu chứng chỉ</h3>
                <p class="text-muted mb-4">Xác thực bằng công nghệ Blockchain</p>

                <form asp-action="VerifyCertificate" method="post" class="text-start">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase" style="color: #718096;">
                            Mã chứng chỉ
                        </label>
                        <input name="code"
                               class="form-control form-control-s4"
                               placeholder="VD: BCERT-2026-XXXX"
                               required />
                    </div>

                    <div class="d-grid mt-4">
                        <button class="btn btn-primary btn-s4-primary text-white">
                            XÁC THỰC NGAY
                        </button>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 border-0 small" style="border-radius: 8px;">
                            <i class="bi bi-exclamation-circle me-2"></i> @ViewBag.Error
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>