@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvPhanQuyen>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý phân quyền";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; // Đảm bảo Layout đúng
}

<style>
    /* ------------------------------------------------------------------ */
    /* CSS TÙY CHỈNH CHO VISION UI (Đồng bộ với các trang khác) */
    /* ------------------------------------------------------------------ */

    /* Card tổng thể - Áp dụng hiệu ứng Kính mờ (Frosted Glass) và Gradient */
    .vision-card {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 22px 22px 22px 22px;
        border-radius: 20px;
        /* Gradient Xanh Tinh Khiết */
        backdrop-filter: blur(120px);
        background: linear-gradient(127.09deg, rgba(15, 60, 110, 0.96) 19.41%, rgba(50, 100, 200, 0.75) 76.65%) border-box;
        box-shadow: none;
        border: none;
        margin-top: 1.5rem;
    }

        /* Header của Card */
        .vision-card .card-header-vision {
            padding: 0 0 1rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .vision-card .card-header-vision h5 {
                color: var(--color-text-light); /* Chữ trắng */
                font-weight: 700;
                margin-bottom: 0;
            }

    /* Bảng */
    .vision-table {
        color: var(--color-text-light);
        border: none !important;
        background-color: transparent !important;
    }

        /* Đảm bảo các ô trong bảng KHÔNG có màu nền trắng/màu mặc định */
        .vision-table > :not(caption) > * > * {
            --bs-table-bg: transparent;
            --bs-table-accent-bg: transparent;
            --bs-table-bg-state: transparent;
            --bs-table-bg-type: transparent;
            box-shadow: none;
            padding: 0.8rem 0.5rem;
        }

        /* Tùy chỉnh DÒNG (TR) để có nền tối nhẹ và hiệu ứng hover */
        .vision-table tbody tr {
            background-color: rgba(17, 28, 68, 0.5);
            border-radius: 10px;
            margin-bottom: 8px;
            transition: background-color 0.3s, box-shadow 0.3s;
            display: table-row;
        }

            .vision-table tbody tr:hover {
                background-color: rgba(17, 28, 68, 0.8);
                box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
            }

        .vision-table tbody td {
            border: none;
            vertical-align: middle;
            text-align: left;
        }

        .vision-table tbody tr:last-child {
            border-bottom: none;
        }


        /* Tiêu đề bảng */
        .vision-table thead th {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            border-top: none;
            color: var(--color-text-muted);
            text-transform: uppercase;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.5rem 0.5rem 1rem 0.5rem;
            text-align: left;
        }

            .vision-table thead th:last-child,
            .vision-table tbody td:last-child {
                text-align: center; /* Cột thao tác căn giữa */
            }

            .vision-table thead th:nth-child(3),
            .vision-table tbody td:nth-child(3) {
                text-align: center; /* Cột Cho phép căn giữa */
            }

    /* Nút Thao tác */
    .vision-btn-create {
        background-color: var(--color-neon-blue);
        border: none;
        color: var(--color-dark-bg) !important;
        font-weight: 700 !important;
        border-radius: 8px;
        padding: 0.5rem 1rem;
    }

    .vision-table .btn-sm {
        border-radius: 8px;
    }
</style>

<div class="vision-card">
    <div class="card-header-vision">
        <h5 class="mb-0"><i class="fas fa-lock me-2"></i> Quản lý Phân quyền</h5>
        <a asp-action="Create" class="btn btn-sm vision-btn-create">
            <i class="fas fa-plus me-1"></i> Thêm mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="table vision-table align-middle">
            <thead>
                <tr>
                    <th style="width: 25%;">Vai trò</th>
                    <th style="width: 35%;">Chức năng</th>
                    <th style="width: 15%; text-align: center;">Cho phép</th>
                    <th style="width: 25%; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><div class="text-white fw-bold">@item.LqvRole?.LqvRoleName</div></td>
                            <td>@item.LqvChucNang?.LqvTenChucNang</td>
                            <td class="text-center">
                                @if (item.LqvChoPhep == true)
                                {
                                    <span class="badge bg-success">✔ Cho phép</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">❌ Không</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.LqvPhanQuyenId" class="btn btn-sm btn-warning me-1" title="Chỉnh sửa">
                                    <i class="fas fa-pencil-alt"></i> Sửa
                                </a>
                                <a asp-action="Details" asp-route-id="@item.LqvPhanQuyenId" class="btn btn-sm btn-info me-1 text-white" title="Chi tiết">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.LqvPhanQuyenId" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa phân quyền này không?')" title="Xóa">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3" style="border: none;">
                            <i class="fas fa-exclamation-circle me-1"></i> Không có dữ liệu phân quyền nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>