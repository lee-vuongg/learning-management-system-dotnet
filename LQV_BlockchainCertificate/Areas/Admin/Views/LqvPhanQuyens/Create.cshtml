@model LQV_BlockchainCertificate.Models.DBModel.LqvPhanQuyen
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Thêm mới phân quyền";
    ViewData["Active"] = "LqvPhanQuyens"; // Đảm bảo Active Menu
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-success card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fas fa-plus-circle me-2"></i> Thêm Mới Phân Quyền
                </h3>
            </div>

            <form asp-action="Create" method="post">
                <div class="card-body">

                    @* Hiển thị Validation Summary (Lỗi chung của model) *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @* --- Vai trò (Role) --- *@
                    <div class="mb-3">
                        <label asp-for="LqvRoleId" class="form-label">Vai trò</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                            <select asp-for="LqvRoleId" class="form-select" asp-items="ViewBag.LqvRoleId">
                                <option value="">--- Chọn Vai trò ---</option>
                            </select>
                        </div>
                        <span asp-validation-for="LqvRoleId" class="text-danger small"></span>
                    </div>

                    @* --- Chức năng (Feature) --- *@
                    <div class="mb-3">
                        <label asp-for="LqvChucNangId" class="form-label">Chức năng</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-cogs"></i></span>
                            <select asp-for="LqvChucNangId" class="form-select" asp-items="ViewBag.LqvChucNangId">
                                <option value="">--- Chọn Chức năng ---</option>
                            </select>
                        </div>
                        <span asp-validation-for="LqvChucNangId" class="text-danger small"></span>
                    </div>

                    @* --- Cho phép (Checkbox Switch) --- *@
                    <div class="mb-3 mt-4">
                        <div class="form-check form-switch">
                            @* Sử dụng form-check-input và form-switch để tạo giao diện toggle switch hiện đại *@
                            <input class="form-check-input" type="checkbox" role="switch" id="LqvChoPhepSwitch" asp-for="LqvChoPhep">
                            <label class="form-check-label fw-bold" for="LqvChoPhepSwitch">
                                <i class="fas fa-lock-open me-1"></i> Cho phép truy cập
                            </label>
                        </div>
                        <span asp-validation-for="LqvChoPhep" class="text-danger small"></span>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i> Lưu
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}