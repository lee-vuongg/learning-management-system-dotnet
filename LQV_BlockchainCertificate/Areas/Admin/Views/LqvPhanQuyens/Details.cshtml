@model LQV_BlockchainCertificate.Models.DBModel.LqvPhanQuyen
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết phân quyền";
    ViewData["Active"] = "LqvPhanQuyens"; // Đảm bảo Active Menu
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card card-info card-outline shadow-sm">
            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fas fa-eye me-2"></i> Chi Tiết Phân Quyền
                </h3>
            </div>

            <div class="card-body">
                <dl class="row detail-list">

                    @* --- Vai trò --- *@
                    <dt class="col-sm-4 text-truncate">
                        <i class="fas fa-user-tag text-primary me-2"></i> Vai trò
                    </dt>
                    <dd class="col-sm-8">
                        **@Model.LqvRole?.LqvRoleName**
                    </dd>

                    @* --- Chức năng --- *@
                    <dt class="col-sm-4 text-truncate">
                        <i class="fas fa-cogs text-info me-2"></i> Chức năng
                    </dt>
                    <dd class="col-sm-8">
                        @Model.LqvChucNang?.LqvTenChucNang
                    </dd>

                    @* --- Cho phép --- *@
                    <dt class="col-sm-4 text-truncate">
                        <i class="fas fa-lock me-2"></i> Cho phép
                    </dt>
                    <dd class="col-sm-8">
                        @{
                            bool allowed = Model.LqvChoPhep;
                            string badgeClass = allowed ? "badge bg-success" : "badge bg-danger";
                            string statusText = allowed ? "✔ CHO PHÉP" : "❌ KHÔNG CHO PHÉP";
                        }
                        <span class="@badgeClass fw-bold">
                            @statusText
                        </span>
                    </dd>
                </dl>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </a>
                <a asp-action="Edit" asp-route-id="@Model.LqvPhanQuyenId" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i> Sửa Phân quyền
                </a>
            </div>
        </div>
    </div>
</div>