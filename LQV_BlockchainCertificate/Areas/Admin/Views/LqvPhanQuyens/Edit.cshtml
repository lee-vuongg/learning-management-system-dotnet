@model LQV_BlockchainCertificate.Models.DBModel.LqvPhanQuyen
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chỉnh sửa phân quyền";
    ViewData["Active"] = "LqvPhanQuyens"; // Đảm bảo Active Menu
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-warning card-outline shadow-sm">

            <div class="card-header">
                <h3 class="card-title fw-bold">
                    <i class="fas fa-user-shield me-2"></i> Chỉnh Sửa Quy Tắc Phân Quyền
                </h3>
            </div>

            <form asp-action="Edit" method="post">
                <div class="card-body">

                    @* Hiển thị Validation Summary (Lỗi chung của model) *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    @* Trường ẩn ID *@
                    <input type="hidden" asp-for="LqvPhanQuyenId" />

                    @* --- Vai trò (Role) --- *@
                    <div class="mb-3">
                        <label asp-for="LqvRoleId" class="form-label">Vai trò</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                            @* Dùng readonly/disabled cho trường này nếu bạn không muốn thay đổi Role khi Edit *@
                            <select asp-for="LqvRoleId" class="form-select" asp-items="ViewBag.LqvRoleId" disabled></select>
                        </div>
                        <span asp-validation-for="LqvRoleId" class="text-danger small"></span>
                        <small class="form-text text-muted">Không thể thay đổi Vai trò.</small>
                    </div>

                    @* --- Chức năng (Feature) --- *@
                    <div class="mb-3">
                        <label asp-for="LqvChucNangId" class="form-label">Chức năng</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-cogs"></i></span>
                            @* Dùng readonly/disabled cho trường này nếu bạn không muốn thay đổi Chức năng khi Edit *@
                            <select asp-for="LqvChucNangId" class="form-select" asp-items="ViewBag.LqvChucNangId" disabled></select>
                        </div>
                        <span asp-validation-for="LqvChucNangId" class="text-danger small"></span>
                        <small class="form-text text-muted">Không thể thay đổi Chức năng.</small>
                    </div>

                    @* --- Cho phép (Checkbox Switch) --- *@
                    <div class="mb-3 mt-4">
                        <div class="form-check form-switch">
                            @* Sử dụng form-check-input và form-switch để tạo giao diện toggle switch hiện đại *@
                            <input class="form-check-input" type="checkbox" role="switch" id="LqvChoPhepSwitch" asp-for="LqvChoPhep">
                            <label class="form-check-label fw-bold" for="LqvChoPhepSwitch">
                                <i class="fas fa-lock-open me-1"></i> Cho phép truy cập
                            </label>
                        </div>
                        <span asp-validation-for="LqvChoPhep" class="text-danger small"></span>
                        <small class="form-text text-muted">Bật để cấp quyền truy cập vào chức năng này cho vai trò được chọn.</small>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning text-dark">
                        <i class="fas fa-save me-1"></i> Cập nhật
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* Lưu ý: Nếu bạn dùng disabled cho Select, bạn cần đảm bảo rằng Controller có thể nhận được giá trị 
        của LqvRoleId và LqvChucNangId (bằng cách thêm input hidden cho chúng) nếu chúng là khóa chính
        hoặc cần thiết cho hành động Edit. *@
    <input type="hidden" asp-for="LqvRoleId" />
    <input type="hidden" asp-for="LqvChucNangId" />
}