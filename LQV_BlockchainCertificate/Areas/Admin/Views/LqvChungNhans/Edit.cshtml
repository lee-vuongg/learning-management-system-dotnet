@model LQV_BlockchainCertificate.Models.DBModel.LqvChungNhan
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Cập nhật chứng nhận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-warning fw-bold mb-3">Cập nhật chứng nhận</h2>
    <div class="card shadow-sm p-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="LqvMaChungNhan" />

            <div class="mb-3">
                <label asp-for="LqvMaChungNhanCode" class="form-label fw-semibold">Mã chứng nhận</label>
                <input asp-for="LqvMaChungNhanCode" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="LqvSinhVienId" class="form-label fw-semibold">Sinh viên</label>
                <select asp-for="LqvSinhVienId" class="form-select" asp-items="ViewBag.LqvSinhVienId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="LqvKhoaHocId" class="form-label fw-semibold">Khóa học</label>
                <select asp-for="LqvKhoaHocId" class="form-select" asp-items="ViewBag.LqvKhoaHocId"></select>
            </div>

            <div class="mb-3">
                <label asp-for="LqvNgayCap" class="form-label fw-semibold">Ngày cấp</label>
                <input asp-for="LqvNgayCap" type="datetime-local" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LqvHashValue" class="form-label fw-semibold">Hash Blockchain</label>
                <input asp-for="LqvHashValue" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LqvTrangThai" class="form-label fw-semibold">Trạng thái</label>
                <select asp-for="LqvTrangThai" class="form-select">
                    <option>Đã cấp</option>
                    <option>Đang xử lý</option>
                    <option>Đã thu hồi</option>
                </select>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
            </div>
        </form>
    </div>
</div>
