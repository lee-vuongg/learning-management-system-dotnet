@model LQV_BlockchainCertificate.Models.DBModel.LqvChungNhan

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="s4-card border-danger">
                <div class="text-center mb-4">
                    <div class="display-4 text-danger mb-3"><i class="fas fa-exclamation-circle"></i></div>
                    <h4 class="fw-bold">Xác nhận xóa</h4>
                    <p class="text-muted">Bạn có chắc chắn muốn xóa vĩnh viễn chứng nhận <strong>@Model.LqvMaChungNhanCode</strong>? Hành động này không thể hoàn tác.</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="small text-muted">Chủ sở hữu:</div>
                    <div class="fw-bold">@Model.LqvSinhVien?.LqvHoTen</div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="LqvMaChungNhan" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill fw-bold">Xác nhận xóa ngay</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill">Hủy và quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>