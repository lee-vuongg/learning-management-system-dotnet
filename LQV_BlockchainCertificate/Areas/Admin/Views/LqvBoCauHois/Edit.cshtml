@model LQV_BlockchainCertificate.Models.DBModel.LqvBoCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Cập nhật bộ câu hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="text-center mb-4 text-warning">
                    <div class="h1"><i class="fas fa-edit"></i></div>
                    <h4 class="fw-bold text-dark">Cập nhật Bộ câu hỏi</h4>
                </div>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="LqvBoCauHoiId" />

                    <div class="mb-3">
                        <label asp-for="LqvTenBo" class="form-label fw-bold small">Tên bộ câu hỏi</label>
                        <input asp-for="LqvTenBo" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="LqvTenBo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LqvMoTa" class="form-label fw-bold small">Mô tả</label>
                        <textarea asp-for="LqvMoTa" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LqvGiangVienId" class="form-label fw-bold small">Giảng viên phụ trách</label>
                        <select asp-for="LqvGiangVienId" asp-items="ViewBag.LqvGiangVienId" class="form-select rounded-3 py-2"></select>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Quay lại</a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">💾 Cập nhật ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>