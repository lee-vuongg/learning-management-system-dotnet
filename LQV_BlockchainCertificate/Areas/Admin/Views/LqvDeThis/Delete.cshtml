@model LQV_BlockchainCertificate.Models.DBModel.LqvDeThi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Xóa đề thi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow rounded-4 p-4 text-center">
                <div class="display-3 text-danger mb-3"><i class="fas fa-trash-alt"></i></div>
                <h4 class="fw-bold mb-3 text-dark">Xác nhận xóa đề thi?</h4>
                <div class="bg-light p-3 rounded-3 mb-4">
                    <p class="text-muted small mb-1">Bạn chuẩn bị xóa đề thi:</p>
                    <h5 class="fw-bold text-danger">@Model.LqvTenDeThi</h5>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="LqvDeThiId" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger rounded-pill fw-bold py-2">Tôi xác nhận xóa</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill py-2">Không, hủy thao tác</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>