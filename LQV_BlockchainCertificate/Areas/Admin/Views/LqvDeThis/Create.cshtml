@model LQV_BlockchainCertificate.Models.DBModel.LqvDeThi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Tạo đề thi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h4 class="fw-bold text-primary mb-4 text-center">➕ Tạo đề thi mới</h4>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="LqvTenDeThi" class="form-label fw-bold small">Tên đề thi</label>
                        <input asp-for="LqvTenDeThi" class="form-control rounded-3 py-2" placeholder="Nhập tên đề..." />
                        <span asp-validation-for="LqvTenDeThi" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LqvBoCauHoiId" class="form-label fw-bold small">Bộ câu hỏi</label>
                        <select asp-for="LqvBoCauHoiId" asp-items="ViewBag.LqvBoCauHoiId" class="form-select rounded-3 py-2">
                            <option value="">-- Chọn bộ câu hỏi --</option>
                        </select>
                        <span asp-validation-for="LqvBoCauHoiId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LqvThoiGianThi" class="form-label fw-bold small">Thời gian (phút)</label>
                            <input asp-for="LqvThoiGianThi" type="number" min="1" class="form-control rounded-3 py-2" />
                            <span asp-validation-for="LqvThoiGianThi" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold small">Tổng điểm</label>
                            <input class="form-control rounded-3 py-2 bg-light text-muted" value="Tự động tính" disabled />
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">💾 Lưu đề thi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>