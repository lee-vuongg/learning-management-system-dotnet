@model LQV_BlockchainCertificate.Models.DBModel.LqvDapAn
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết đáp án";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h3>📄 Chi tiết đáp án</h3>
<hr />

<table class="table table-bordered">
    <tr>
        <th>Câu hỏi</th>
        <td>@Model.LqvCauHoi?.LqvNoiDung</td>
    </tr>
    <tr>
        <th>Nội dung đáp án</th>
        <td>@Model.LqvNoiDung</td>
    </tr>
    <tr>
        <th>Trạng thái</th>
        <td>
            @if (Model.LqvDung)
            {
                <span class="badge bg-success">Đúng</span>
            }
            else
            {
                <span class="badge bg-danger">Sai</span>
            }
        </td>
    </tr>
</table>

<a asp-action="Edit" asp-route-id="@Model.LqvDapAnId" class="btn btn-warning">✏️ Sửa</a>
<a asp-action="Index" class="btn btn-secondary">⬅ Quay lại</a>
