@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvYeuCauHoTro>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Danh sách Yêu cầu Hỗ trợ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Điều chỉnh các thành phần Bootstrap để phù hợp với Dark Mode và Neon */
    :root {
        --color-card-bg: #1c233a; /* Nền card tối */
        --color-text-light: #e0e7ff; /* Text sáng */
        --color-neon-blue: #4fd1c5; /* Neon Cyan */
        --color-dark-bg: #0d1222; /* Nền rất tối */
        --border-radius-lg: 12px;
        --color-text-muted: #8c97b8;
        --gradient-primary: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
    }

    .table-custom {
        background-color: var(--color-card-bg); /* Sử dụng nền card tối */
        color: var(--color-text-light);
        border-radius: var(--border-radius-lg);
        overflow: hidden; /* Đảm bảo các góc được bo tròn */
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

        .table-custom th {
            color: var(--color-neon-blue); /* Màu Neon cho tiêu đề cột */
            border-bottom: 2px solid #323b6b;
        }

        .table-custom td {
            border-top: 1px solid #273059; /* Đường kẻ mỏng hơn */
        }

    .table-hover tbody tr:hover {
        background-color: #1a2455; /* Hiệu ứng hover nhẹ */
    }

    /* Các nút hành động neon */
    .btn-neon-primary { /* Đổi tên để dùng cho nút chung */
        background: var(--gradient-primary);
        border: none;
        color: var(--color-dark-bg);
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-neon-primary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: var(--color-dark-bg);
        }

    /* Badge trạng thái */
    .badge-custom {
        display: inline-block;
        padding: 0.35em 0.65em;
        font-size: 0.8em;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: 0.375rem;
    }

    .badge-pending {
        background-color: #f6ad55 !important; /* Vàng Cam - Chờ xử lý */
        color: #000 !important;
    }

    .badge-processing {
        background-color: #38b2ac !important; /* Xanh ngọc - Đang xử lý */
        color: #fff !important;
    }

    .badge-resolved {
        background-color: #48bb78 !important; /* Xanh lá - Đã xử lý */
        color: #000 !important;
    }

    /* Alert cho TempData */
    .alert-neon-success {
        background-color: #2b6c67;
        color: #e0e7ff;
        border-color: var(--color-neon-blue);
    }

    .alert-neon-info {
        background-color: #273059;
        color: #e0e7ff;
        border-color: #323b6b;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold" style="color: var(--color-neon-blue);">@ViewData["Title"]</h1>
</div>

@* Hiển thị TempData *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-neon-success alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-neon-info alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive card-custom p-3">
    <table class="table table-custom table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#ID</th>
                <th>Người dùng</th>
                <th>@Html.DisplayNameFor(model => model.LqvNoiDung)</th>
                <th>@Html.DisplayNameFor(model => model.LqvThoiGianGui)</th>
                <th>@Html.DisplayNameFor(model => model.LqvTrangThai)</th>
                <th>Phản hồi Admin</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.LqvId)</strong>
                    </td>
                    <td>
                        @* Hiển thị Tên người dùng thay vì ID *@
                        <i class="fas fa-user-circle me-1"></i>
                        @Html.DisplayFor(modelItem => item.LqvNguoiDung.LqvHoTen)
                    </td>
                    <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.LqvNoiDung">
                        @{
                            string displayNoiDung = item.LqvNoiDung ?? "";
                            string truncatedNoiDung = displayNoiDung.Length > 80 ? displayNoiDung.Substring(0, 80) + "..." : displayNoiDung;
                        }
                        @truncatedNoiDung
                    </td>
                    <td>
                        @(item.LqvThoiGianGui.HasValue ? item.LqvThoiGianGui.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                    </td>
                    <td>
                        @{
                            string statusClass = item.LqvTrangThai switch
                            {
                                "Chờ xử lý" => "badge-pending",
                                "Đang xử lý" => "badge-processing",
                                "Đã xử lý" => "badge-resolved",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge-custom @statusClass">
                            @Html.DisplayFor(modelItem => item.LqvTrangThai)
                        </span>
                    </td>
                    <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.LqvPhanHoi">
                        @{
                            string displayPhanHoi = item.LqvPhanHoi ?? "";
                            if (string.IsNullOrEmpty(displayPhanHoi))
                            {
                                <span class="text-muted fst-italic">Chưa phản hồi</span>
                            }
                            else
                            {
                                string truncatedPhanHoi = displayPhanHoi.Length > 50 ? displayPhanHoi.Substring(0, 50) + "..." : displayPhanHoi;
                                @truncatedPhanHoi
                            }
                        }
                    </td>
                    <td class="text-center">
                        <div class="d-flex gap-2 justify-content-center">
                            <a asp-action="Edit" asp-route-id="@item.LqvId" class="btn btn-sm btn-neon-primary" title="Phản hồi/Cập nhật"><i class="fas fa-reply"></i></a>
                            <a asp-action="Details" asp-route-id="@item.LqvId" class="btn btn-sm btn-outline-info" style="color:var(--color-neon-blue); border-color:var(--color-neon-blue);" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.LqvId" class="btn btn-sm btn-neon-danger" title="Xóa yêu cầu"><i class="fas fa-trash-alt"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center p-5 rounded" style="background-color: #1a2455; color: var(--color-text-muted);">
            <i class="fas fa-inbox fa-3x mb-3"></i>
            <p class="fw-bold">Không có yêu cầu hỗ trợ nào.</p>
        </div>
    }
</div>