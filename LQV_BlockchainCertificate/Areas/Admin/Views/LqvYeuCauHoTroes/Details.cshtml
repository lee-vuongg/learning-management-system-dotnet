@model LQV_BlockchainCertificate.Models.DBModel.LqvYeuCauHoTro
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết Yêu cầu Hỗ trợ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // Logic xác định class CSS cho trạng thái
    string statusText = Model.LqvTrangThai ?? "Không xác định";
    string statusClass = statusText switch
    {
        "Chờ xử lý" => "text-warning",
        "Đang xử lý" => "text-info",
        "Đã xử lý" => "text-success",
        _ => "text-secondary"
    };
}

<style>
    :root {
        --color-card-bg: #1c233a;
        --color-text-light: #e0e7ff;
        --color-neon-blue: #4fd1c5;
        --color-dark-bg: #0d1222;
        --border-radius-lg: 12px;
        --color-text-muted: #8c97b8;
        --gradient-primary: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
    }

    .card-custom {
        background-color: var(--color-card-bg);
        color: var(--color-text-light);
        border-radius: var(--border-radius-lg);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        border: 1px solid #323b6b;
    }

    .btn-neon-primary {
        background: var(--gradient-primary);
        border: none;
        color: var(--color-dark-bg);
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-neon-primary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: var(--color-dark-bg);
        }
</style>

<div class="d-flex justify-content-center">
    <div class="card card-custom p-5 mx-auto" style="max-width: 800px;">
        <h1 class="h3 mb-4 fw-bold text-center border-bottom pb-2" style="color: var(--color-neon-blue);">
            @ViewData["Title"] - #@Model.LqvId
        </h1>

        <div class="row">
            <div class="col-md-12">
                <dl class="row mb-4">
                    <dt class="col-sm-4 fw-bold" style="color: var(--color-text-muted);">ID Yêu cầu:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.LqvId)</dd>

                    <dt class="col-sm-4 fw-bold" style="color: var(--color-text-muted);">Người gửi:</dt>
                    <dd class="col-sm-8"><strong>@Html.DisplayFor(model => model.LqvNguoiDung.LqvHoTen)</strong> (ID: @Html.DisplayFor(model => model.LqvNguoiDung.LqvId))</dd>

                    <dt class="col-sm-4 fw-bold" style="color: var(--color-text-muted);">Thời gian gửi:</dt>
                    <dd class="col-sm-8">@(Model.LqvThoiGianGui.HasValue ? Model.LqvThoiGianGui.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</dd>

                    <dt class="col-sm-4 fw-bold" style="color: var(--color-text-muted);">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        <span class="fw-bold @statusClass">
                            @statusText
                        </span>
                    </dd>
                </dl>
            </div>

            <hr class="my-3" style="border-color: #323b6b;" />

            <div class="col-12 mb-4">
                <h5 class="fw-bold" style="color: var(--color-neon-blue);"><i class="fas fa-question-circle me-2"></i>Nội dung Yêu cầu</h5>
                <div class="p-3 border rounded" style="background-color: #273059; border-color: #323b6b !important;">
                    @Html.DisplayFor(model => model.LqvNoiDung)
                </div>
            </div>

            <div class="col-12 mb-4">
                <h5 class="fw-bold text-info"><i class="fas fa-reply-all me-2"></i>Phản hồi của Admin</h5>
                <div class="p-3 border rounded" style="background-color: #273059; border-color: #323b6b !important;">
                    @if (!string.IsNullOrEmpty(Model.LqvPhanHoi))
                    {
                        @Html.DisplayFor(model => model.LqvPhanHoi)
                    }
                    else
                    {
                        <p class="text-warning fst-italic mb-0">Chưa có phản hồi. Vui lòng nhấn "Cập nhật/Phản hồi" để xử lý.</p>
                    }
                </div>
            </div>

            <hr class="mt-3" style="border-color: #323b6b;" />

            <div class="d-flex justify-content-between pt-3">
                <a asp-action="Edit" asp-route-id="@Model?.LqvId" class="btn btn-neon-primary"><i class="fas fa-edit me-2"></i>Cập nhật/Phản hồi</a>
                <a asp-action="Index" class="btn btn-outline-secondary" style="color:var(--color-text-muted); border-color:var(--color-text-muted);"><i class="fas fa-arrow-left me-2"></i>Quay lại Danh sách</a>
            </div>
        </div>
    </div>
</div>