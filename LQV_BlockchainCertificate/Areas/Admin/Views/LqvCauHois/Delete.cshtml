@model LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Xóa câu hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="text-danger">⚠️ Xác nhận xóa</h3>
<hr />

<p><b>Câu hỏi:</b> @Model.LqvNoiDung</p>
<p><b>Bộ:</b> @Model.LqvBoCauHoi.LqvTenBo</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="LqvCauHoiId" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
