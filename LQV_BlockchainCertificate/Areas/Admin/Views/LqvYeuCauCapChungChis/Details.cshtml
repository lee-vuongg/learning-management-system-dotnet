@model LQV_BlockchainCertificate.Models.DBModel.LqvChungNhan
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết chứng nhận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --s4-primary: #007bff;
        --s4-bg: #f8f9fa;
    }

    .s4-wrapper {
        padding: 2rem 1.5rem;
        background: var(--s4-bg);
        min-height: 100vh;
    }

    .s4-card {
        background: #fff;
        border-radius: 20px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    /* Header Style */
    .cert-header {
        background: linear-gradient(135deg, #0062ff 0%, #00c6ff 100%);
        padding: 40px;
        color: white;
    }

    .cert-status-pill {
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(5px);
        padding: 6px 16px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Info Section */
    .info-label {
        color: #6c757d;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #2d3436;
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 20px;
    }

    /* Blockchain Block */
    .blockchain-box {
        background: #f1f3f9;
        border-radius: 16px;
        padding: 25px;
        border: 1px dashed #cbd5e0;
    }

    .hash-text {
        font-family: 'Roboto Mono', monospace;
        font-size: 0.85rem;
        word-break: break-all;
        color: #4a5568;
        background: #fff;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .btn-verify {
        background: #2d3436;
        color: white;
        border-radius: 10px;
        padding: 12px 24px;
        font-weight: 600;
        transition: all 0.3s;
        border: none;
    }

        .btn-verify:hover {
            background: #000;
            color: #fff;
            transform: translateY(-2px);
        }
</style>

<div class="s4-wrapper">
    <div class="container" style="max-width: 900px;">
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                <i class="fas fa-arrow-left me-2"></i>QUAY LẠI DANH SÁCH
            </a>
        </div>

        <div class="s4-card">
            <div class="cert-header text-center text-md-start">
                <div class="d-md-flex justify-content-between align-items-center">
                    <div>
                        <span class="cert-status-pill mb-3 d-inline-block">
                            <i class="fas fa-check-circle me-1"></i> @Model.LqvTrangThai
                        </span>
                        <h2 class="fw-bold mb-1">Chứng nhận kết quả học tập</h2>
                        <p class="opacity-75 mb-0">Mã định danh hệ thống: #@Model.LqvMaChungNhanCode</p>
                    </div>
                    <div class="mt-3 mt-md-0">
                        <i class="fas fa-certificate fa-4x opacity-25"></i>
                    </div>
                </div>
            </div>

            <div class="p-4 p-md-5">
                <div class="row">
                    <div class="col-md-6 border-end-md">
                        <div class="mb-4">
                            <label class="info-label">Họ và tên sinh viên</label>
                            <div class="info-value">@Model.LqvSinhVien?.LqvHoTen</div>
                        </div>
                        <div class="mb-4">
                            <label class="info-label">Khóa học hoàn thành</label>
                            <div class="info-value text-primary">@Model.LqvKhoaHoc?.LqvTenKhoaHoc</div>
                        </div>
                        <div class="mb-4">
                            <label class="info-label">Ngày cấp chứng nhận</label>
                            <div class="info-value">@Model.LqvNgayCap.ToString("dd MMMM, yyyy")</div>
                        </div>
                        <div class="mb-0">
                            <label class="info-label">Mã Hash nội bộ (Internal Hash)</label>
                            <div class="hash-text mt-2">@Model.LqvHashValue</div>
                        </div>
                    </div>

                    <div class="col-md-6 ps-md-5 mt-4 mt-md-0">
                        <h5 class="fw-bold mb-4"><i class="fas fa-link text-info me-2"></i>Xác thực Blockchain</h5>

                        @if (Model.LqvGiaoDichBlockchains != null && Model.LqvGiaoDichBlockchains.Any())
                        {
                            var bc = Model.LqvGiaoDichBlockchains.First();
                            <div class="blockchain-box">
                                <div class="mb-3">
                                    <label class="info-label">Transaction Hash</label>
                                    <div class="hash-text small mt-1">@bc.LqvTxHash</div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <label class="info-label">Block</label>
                                        <div class="fw-bold text-dark">#@bc.LqvBlockNumber</div>
                                    </div>
                                    <div class="col-6">
                                        <label class="info-label">Status</label>
                                        <div class="text-success fw-bold small">Confirmed</div>
                                    </div>
                                </div>
                                <div class="d-grid mt-4">
                                    <a href="https://sepolia.etherscan.io/tx/@bc.LqvTxHash"
                                       target="_blank"
                                       class="btn btn-verify text-center text-decoration-none">
                                        <i class="fas fa-external-link-alt me-2"></i>Verify on Etherscan
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 bg-light rounded-4">
                                <i class="fas fa-info-circle text-muted mb-2 fa-2x"></i>
                                <p class="text-muted mb-0">Dữ liệu đang được đồng bộ lên Blockchain...</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top d-flex flex-wrap gap-2">
                    <button class="btn btn-primary px-4 rounded-pill fw-bold">
                        <i class="fas fa-download me-2"></i>Tải bản PDF
                    </button>
                    <button class="btn btn-outline-secondary px-4 rounded-pill fw-bold">
                        <i class="fas fa-share-alt me-2"></i>Chia sẻ
                    </button>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <p class="text-muted small">
                © 2026 LQV_BlockchainCertificate System. Tất cả chứng nhận đều được mã hóa bằng thuật toán SHA-256.
            </p>
        </div>
    </div>
</div>