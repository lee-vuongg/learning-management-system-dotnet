@model LQV_BlockchainCertificate.Models.DBModel.LqvLichThi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = (Model?.LqvLichThiId > 0 ? "Cập nhật" : "Thêm") + " lịch thi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .s4-form-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 40px rgba(0,0,0,0.06);
        background: #fff;
    }

    .s4-label {
        font-weight: 600;
        color: #444;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
    }

    .s4-input {
        border: 2px solid #edf2f7;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.95rem;
        transition: 0.3s;
    }

        .s4-input:focus {
            border-color: #1976d2;
            box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.05);
            outline: none;
        }

    .s4-btn-save {
        background: #1976d2;
        color: #fff;
        border-radius: 12px;
        padding: 12px 40px;
        font-weight: 700;
        border: none;
        transition: 0.3s;
    }

        .s4-btn-save:hover {
            background: #1565c0;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(25, 118, 210, 0.2);
        }

    .s4-alert {
        border: none;
        border-radius: 12px;
        background: #fff5f5;
        color: #e53e3e;
        font-size: 0.9rem;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="s4-form-card p-4 p-md-5">
                <div class="text-center mb-5">
                    <h3 class="fw-bold">@ViewData["Title"]</h3>
                    <p class="text-muted">Thiết lập thời gian và phạm vi cho kỳ thi</p>
                </div>

                <form asp-action="@(Model?.LqvLichThiId > 0 ? "Edit" : "Create")" method="post">
                    @if (Model?.LqvLichThiId > 0)
                    {
                        <input type="hidden" asp-for="LqvLichThiId" />
                    }
                    <div asp-validation-summary="All" class="alert s4-alert"></div>

                    <div class="mb-4">
                        <label class="s4-label">Lựa chọn đề thi</label>
                        <select asp-for="LqvDeThiId" class="form-select s4-input" asp-items="ViewBag.LqvDeThiId">
                            <option value="">-- Chọn đề thi --</option>
                        </select>
                        <span asp-validation-for="LqvDeThiId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="s4-label">Lớp học tham gia</label>
                        <select asp-for="LqvLopHocId" class="form-select s4-input" asp-items="ViewBag.LqvLopHocId">
                            <option value="">-- Chọn lớp học --</option>
                        </select>
                        <span asp-validation-for="LqvLopHocId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="s4-label">Thời gian mở đề</label>
                            <input asp-for="LqvBatDau" type="datetime-local" class="form-control s4-input" />
                            <span asp-validation-for="LqvBatDau" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="s4-label">Thời gian đóng đề</label>
                            <input asp-for="LqvKetThuc" type="datetime-local" class="form-control s4-input" />
                            <span asp-validation-for="LqvKetThuc" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-4 border-top">
                        <a asp-action="Index" class="text-muted text-decoration-none fw-600"><i class="fas fa-chevron-left me-2"></i> Quay lại</a>
                        <button type="submit" class="s4-btn-save">Xác nhận lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>