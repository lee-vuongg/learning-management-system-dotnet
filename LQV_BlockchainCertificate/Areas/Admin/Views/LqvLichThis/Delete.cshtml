@model LQV_BlockchainCertificate.Models.DBModel.LqvLichThi
@{
    ViewData["Title"] = "Xóa lịch thi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                <div class="card-body p-5 text-center">
                    <div class="mb-4 text-danger">
                        <i class="fas fa-exclamation-triangle fa-4x"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Xác nhận xóa?</h4>
                    <p class="text-muted mb-4">Bạn đang thực hiện xóa lịch thi của đề <b>@Model.LqvDeThi?.LqvTenDeThi</b>. Hành động này không thể hoàn tác.</p>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="LqvLichThiId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-3 fw-bold shadow-sm" style="border-radius: 12px;">XÓA NGAY LẬP TỨC</button>
                            <a asp-action="Index" class="btn btn-light py-3 fw-bold" style="border-radius: 12px; color: #636e72;">Hủy bỏ</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>