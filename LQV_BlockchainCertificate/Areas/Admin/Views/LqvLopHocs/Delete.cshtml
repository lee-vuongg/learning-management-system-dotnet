@model LQV_BlockchainCertificate.Models.DBModel.LqvLopHoc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Xóa lớp học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="vision-card border-danger">
    <div class="card-header-vision bg-danger text-white">
        <h5 class="mb-0">
            <i class="fas fa-exclamation-triangle me-2"></i> Xác nhận xóa lớp học
        </h5>
    </div>

    <div class="card-body">
        <p class="text-danger fw-bold">
            Bạn có chắc chắn muốn xóa lớp học này không? Hành động này không thể hoàn tác.
        </p>

        <table class="table vision-table">
            <tr>
                <th width="200">Tên lớp</th>
                <td>@Model.LqvTenLop</td>
            </tr>
            <tr>
                <th>Khóa học</th>
                <td>@Model.LqvKhoaHoc?.LqvTenKhoaHoc</td>
            </tr>
            <tr>
                <th>Giảng viên</th>
                <td>@Model.LqvGiangVien?.LqvHoTen</td>
            </tr>
            <tr>
                <th>Ngày tạo</th>
                <td>@Model.LqvNgayTao?.ToString("dd/MM/yyyy")</td>
            </tr>
        </table>
    </div>

    <div class="card-footer text-end">
        <form asp-action="Delete">
            <input type="hidden" asp-for="LqvLopHocId" />
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Hủy
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Xóa
            </button>
        </form>
    </div>
</div>
