@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvKhoaHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Đăng ký Khóa học mới";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h4 class="mb-4 text-primary">📚 Khám phá và Đăng ký Khóa học</h4>
            <p class="text-sm text-secondary">
                Duyệt qua danh sách các khóa học hiện có và nhấn "Đăng ký" để bắt đầu hành trình học tập của bạn.
                <a asp-action="Index" class="text-info font-weight-bold ms-2">Xem các khóa học bạn đã đăng ký.</a>
            </p>

            <hr class="my-3">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-white" role="alert">
                    <span class="alert-icon"><i class="fas fa-check"></i></span>
                    <span class="alert-text"><strong>Thành công!</strong> @TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger text-white" role="alert">
                    <span class="alert-icon"><i class="fas fa-times"></i></span>
                    <span class="alert-text"><strong>Lỗi!</strong> @TempData["ErrorMessage"]</span>
                </div>
            }

            <div class="row">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-xl-4 col-md-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-body p-3">
                                    <h5 class="mb-1 text-dark">@item.LqvTenKhoaHoc</h5>
                                    <p class="text-sm text-secondary mb-3">Giảng viên: **@item.LqvGiangVien.LqvHoTen**</p>

                                    <p class="text-xs text-truncate" style="max-height: 40px; overflow: hidden;">
                                        @item.LqvMoTa
                                    </p>

                                    <div class="d-flex justify-content-between align-items-center pt-2 mt-3 border-top">
                                        <small class="text-xs text-info">Bắt đầu: @item.LqvNgayBatDau?.ToString("dd/MM/yyyy")</small>

                                        <form asp-action="Enroll" asp-route-id="@item.LqvMaKhoaHoc" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-primary btn-sm mb-0">
                                                <i class="fas fa-user-plus me-1"></i> Đăng ký
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info text-white text-center" role="alert">
                            <span class="alert-icon"><i class="fas fa-info-circle"></i></span>
                            <span class="alert-text">Hiện tại không có khóa học nào đang mở để đăng ký.</span>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>