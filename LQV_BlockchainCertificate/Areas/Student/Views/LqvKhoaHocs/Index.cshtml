@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvKhoaHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Khóa học của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    var progressData = ViewBag.CourseProgress as Dictionary<int, double>;
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h4 class="mb-4 text-primary">🎓 Khóa học đã đăng ký</h4>

            <p class="text-sm text-secondary">
                Đây là danh sách các khóa học mà bạn đã đăng ký. Bạn có thể xem chi tiết tiến độ học tập và thông tin chứng nhận tại đây.
                <a asp-action="ListAll" class="text-primary font-weight-bold ms-2">Tìm kiếm và đăng ký Khóa học mới.</a>
            </p>

            <hr class="my-3">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-white" role="alert">
                    <span class="alert-icon"><i class="fas fa-check"></i></span>
                    <span class="alert-text"><strong>Thành công!</strong> @TempData["SuccessMessage"]</span>
                </div>
            }

            <div class="row">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var percent = progressData != null && progressData.ContainsKey(item.LqvMaKhoaHoc)
                        ? progressData[item.LqvMaKhoaHoc]
                        : 0;

                        <div class="col-xl-4 col-md-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-body p-3">
                                    <h5 class="mb-1 text-dark">@item.LqvTenKhoaHoc</h5>
                                    <p class="text-sm text-secondary mb-3">
                                        Giảng viên: <strong>@item.LqvGiangVien?.LqvHoTen</strong>
                                    </p>

                                    <p class="text-xs text-truncate" style="max-height: 40px; overflow: hidden;">
                                        @item.LqvMoTa
                                    </p>

                                    <!-- 🎯 Thanh tiến độ -->
                                    <div class="mt-3">
                                        <p class="text-xs mb-1 text-muted">Tiến độ học tập: <strong>@percent%</strong></p>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                                                 role="progressbar"
                                                 style="width: @percent%; transition: width 1s ease;"
                                                 aria-valuenow="@percent"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top">
                                        <div class="text-xs text-success">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            Bắt đầu: @item.LqvNgayBatDau?.ToString("dd/MM/yyyy")
                                        </div>

                                        <a asp-action="Details"
                                           asp-route-id="@item.LqvMaKhoaHoc"
                                           class="btn btn-primary btn-sm mb-0">
                                            Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info text-white text-center" role="alert">
                            <span class="alert-icon"><i class="fas fa-info-circle"></i></span>
                            <span class="alert-text">
                                Bạn chưa đăng ký khóa học nào. Hãy nhấn
                                <a asp-action="ListAll" class="text-white font-weight-bold text-decoration-underline">vào đây</a>
                                để khám phá các khóa học mới!
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
