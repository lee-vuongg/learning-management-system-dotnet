@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Check-in buổi học";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>

    .checkin-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        max-width: 520px;
        margin: auto;
        margin-top: 30px;
    }

    .checkin-header {
        background: #2c3e50;
        color: white;
        padding: 18px;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .checkin-body {
        padding: 25px;
    }

    .camera-box {
        text-align: center;
    }

    video {
        border-radius: 10px;
        border: 2px solid #ddd;
    }

    .btn-checkin {
        width: 100%;
        padding: 12px;
        font-weight: bold;
    }

    .status-box {
        background: #f8f9fa;
        border: 1px solid #eee;
        padding: 10px;
        border-radius: 6px;
        font-size: 14px;
    }

</style>

<div class="container">

    <div class="card checkin-card">

        <div class="checkin-header">
            <h4>📍 Check-in buổi học</h4>
        </div>

        <div class="checkin-body">

            <div class="alert alert-info text-center">
                Vui lòng bật GPS và nhìn vào camera để điểm danh
            </div>

            <!-- CAMERA SELECT -->
            <div class="mb-3 text-center">
                <select id="cameraSelect" class="form-select form-select-sm"></select>
            </div>

            <!-- CAMERA -->
            <div class="camera-box mb-3">

                <video id="video" width="320" height="240" autoplay muted></video>

                <canvas id="canvas" width="320" height="240" style="display:none"></canvas>

                <div id="faceStatus" class="mt-2 text-danger">
                    Đang khởi động camera...
                </div>

            </div>

            @if (ViewBag.ThoiGianConLai != null)
            {
                <div class="alert alert-warning text-center fw-bold">
                    ⏳ Thời gian còn lại:
                    <span id="countdown" class="text-danger"></span>
                </div>
            }

            <form id="checkinForm" asp-action="CheckIn" method="post" enctype="multipart/form-data">

                <input type="hidden" name="buoiHocId" value="@ViewBag.BuoiHoc.LqvBuoiHocId" />

                <input type="hidden" name="viDo" id="viDo" />
                <input type="hidden" name="kinhDo" id="kinhDo" />

                <input type="file" name="faceImage" id="faceImageInput" hidden />

                <button class="btn btn-success btn-checkin" id="btnCheckIn" disabled>
                    📍 CHECK-IN NGAY
                </button>

            </form>

            <div class="mt-4 text-center">

                <div id="gpsStatus" class="status-box text-muted">
                    Đang lấy vị trí GPS...
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        let video = document.getElementById("video")
        let canvas = document.getElementById("canvas")
        let cameraSelect = document.getElementById("cameraSelect")
        let faceInput = document.getElementById("faceImageInput")
        let currentStream = null

        //------------------------------------------------
        // LOAD CAMERA
        //------------------------------------------------

        async function loadCameras(){

        const devices = await navigator.mediaDevices.enumerateDevices()

        const cameras = devices.filter(d => d.kind === "videoinput")

        cameraSelect.innerHTML=""

        cameras.forEach((cam,index)=>{

        let option=document.createElement("option")

        option.value=cam.deviceId
        option.text=cam.label || "Camera "+(index+1)

        cameraSelect.appendChild(option)

        })

        if(cameras.length>0)
        startCamera(cameras[0].deviceId)

        }

        //------------------------------------------------
        // START CAMERA
        //------------------------------------------------

        async function startCamera(deviceId){

        if(currentStream){
        currentStream.getTracks().forEach(t=>t.stop())
        }

        try{

        const stream = await navigator.mediaDevices.getUserMedia({
        video:{deviceId:{exact:deviceId}}
        })

        currentStream=stream

        video.srcObject=stream

        document.getElementById("faceStatus").innerText="✔ Camera sẵn sàng"

        }
        catch{

        document.getElementById("faceStatus").innerText="❌ Không mở được camera"

        }

        }

        cameraSelect.addEventListener("change",function(){
        startCamera(this.value)
        })

        loadCameras()

        //------------------------------------------------
        // GPS
        //------------------------------------------------

        function loadGPS(){

        if(!navigator.geolocation){
        document.getElementById("gpsStatus").innerText="❌ Trình duyệt không hỗ trợ GPS"
        return
        }

        navigator.geolocation.getCurrentPosition(

        function(pos){

        let lat=pos.coords.latitude
        let lng=pos.coords.longitude

        document.getElementById("viDo").value=lat
        document.getElementById("kinhDo").value=lng

        document.getElementById("gpsStatus").innerText=
        "✔ GPS sẵn sàng ("+lat.toFixed(6)+", "+lng.toFixed(6)+")"

        document.getElementById("btnCheckIn").disabled=false

        },

        function(){

        document.getElementById("gpsStatus").innerText="❌ Không lấy được GPS"

        }

        )

        }

        loadGPS()

        //------------------------------------------------
        // SUBMIT -> CHỤP ẢNH
        //------------------------------------------------

        document.getElementById("checkinForm").addEventListener("submit",function(e){

        e.preventDefault()

        const ctx = canvas.getContext("2d")

        ctx.drawImage(video,0,0,canvas.width,canvas.height)

        canvas.toBlob(function(blob){

        let file = new File([blob],"face.jpg",{type:"image/jpeg"})

        let dt = new DataTransfer()

        dt.items.add(file)

        faceInput.files=dt.files

        document.getElementById("faceStatus").innerText="📸 Đang gửi FaceID..."

        e.target.submit()

        },"image/jpeg")

        })

    </script>


    @if (ViewBag.ThoiGianConLai != null)
    {

        <script>

            let seconds=@ViewBag.ThoiGianConLai

            function updateCountdown(){

            if(seconds<=0){

            document.getElementById("countdown").innerText="0 phút 0 giây"

            document.getElementById("btnCheckIn").disabled=true

            return

            }

            let minutes=Math.floor(seconds/60)
            let secs=seconds%60

            document.getElementById("countdown").innerText=
            minutes+" phút "+secs+" giây"

            seconds--

            }

            updateCountdown()

            setInterval(updateCountdown,1000)

        </script>

    }

}