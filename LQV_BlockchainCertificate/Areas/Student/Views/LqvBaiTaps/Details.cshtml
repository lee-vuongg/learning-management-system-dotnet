@model LQV_BlockchainCertificate.Models.DBModel.LqvBaiTap
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = Model.LqvTieuDe;
    bool daNop = ViewBag.DaNop as bool? ?? false;
    dynamic nopBai = ViewBag.NopBai;
    bool conHan = ViewBag.ConHan as bool? ?? false;
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    :root {
        --s4-primary: #1a73e8; /* Blue Classroom */
        --s4-success: #0f9d58; /* Green Classroom */
        --s4-warning: #f4b400;
        --s4-text-main: #202124;
        --s4-text-sub: #5f6368;
        --s4-bg-light: #f8f9fa;
        --s4-border: #dadce0;
        --s4-shadow: 0 1px 2px 0 rgba(60,64,67,.30), 0 1px 3px 1px rgba(60,64,67,.15);
    }

    body {
        background-color: #ffffff;
        font-family: 'Inter', sans-serif;
        color: var(--s4-text-main);
        line-height: 1.6;
    }

    /* Main Container */
    .assignment-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* Header Section */
    .classroom-header {
        border-bottom: 1px solid var(--s4-border);
        padding-bottom: 1rem;
        margin-bottom: 2rem;
    }

    .assignment-icon-bg {
        background-color: var(--s4-primary);
        color: white;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .assignment-title {
        color: var(--s4-primary);
        font-size: 1.75rem;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .meta-info {
        font-size: 0.875rem;
        color: var(--s4-text-sub);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 0.5rem;
    }

    /* Description Area */
    .description-content {
        font-size: 0.95rem;
        color: #3c4043;
        white-space: pre-line;
    }

    /* Submission Card (Study4/Classroom Style) */
    .submission-card {
        background: #fff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: var(--s4-shadow);
        border: 1px solid var(--s4-border);
        position: sticky;
        top: 20px;
    }

    .status-badge {
        font-weight: 600;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 12px;
    }

    /* File Preview Item */
    .file-item {
        border: 1px solid var(--s4-border);
        border-radius: 6px;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        margin-bottom: 12px;
        transition: background 0.2s;
        text-decoration: none !important;
        color: inherit;
    }

        .file-item:hover {
            background-color: var(--s4-bg-light);
        }

    /* Custom Form Styling */
    .dashed-upload {
        border: 2px dashed var(--s4-border);
        border-radius: 6px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        display: block;
    }

        .dashed-upload:hover {
            border-color: var(--s4-primary);
            background: rgba(26, 115, 232, 0.04);
            color: var(--s4-primary);
        }

    .form-control:focus {
        border-color: var(--s4-primary);
        box-shadow: none;
    }

    /* Instructor Feedback Area */
    .feedback-box {
        background-color: #f1f8e9;
        border-radius: 8px;
        padding: 20px;
        border-left: 4px solid var(--s4-success);
    }

    .points-display {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--s4-primary);
    }
</style>

<div class="assignment-container">
    <div class="row">
        <div class="col-lg-8 pe-lg-5">
            <div class="classroom-header">
                <div class="d-flex align-items-center mb-3">
                    <div class="assignment-icon-bg me-3">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <h1 class="assignment-title mb-0">@Model.LqvTieuDe</h1>
                </div>

                <div class="meta-info">
                    <div class="d-flex align-items-center">
                        <img src="@(Model.LqvGiangVien?.LqvAvt ?? "/img/default-avatar.jpg")"
                             class="rounded-circle me-2" width="32" height="32" style="object-fit: cover;">
                        <span class="fw-bold text-dark">@Model.LqvGiangVien?.LqvHoTen</span>
                        <span class="mx-2">•</span>
                        <span>Đã đăng: @Model.LqvNgayTao.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="text-dark fw-500">
                        Hạn nộp: @Model.LqvHanNop.ToString("HH:mm dd/MM/yyyy")
                    </div>
                </div>
            </div>

            <div class="description-content mb-5">
                @Html.Raw(Model.LqvMoTa)
            </div>

            <hr class="my-5" style="border-top: 1px solid #dadce0;">

            @if (daNop && nopBai != null && nopBai.LqvDaCham)
            {
                <div class="feedback-box">
                    <h6 class="text-success fw-bold mb-3"><i class="fas fa-check-circle me-2"></i>KẾT QUẢ ĐÁNH GIÁ</h6>
                    <div class="row align-items-center">
                        <div class="col-sm-3 text-center border-end">
                            <div class="text-muted small">ĐIỂM SỐ</div>
                            <div class="points-display">@nopBai.LqvDiem/10</div>
                        </div>
                        <div class="col-sm-9 ps-4">
                            <div class="text-muted small mb-1">NHẬN XÉT CỦA GIẢNG VIÊN</div>
                            <p class="mb-0 font-italic">"@nopBai.LqvNhanXet"</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="submission-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-bold" style="font-size: 1.1rem;">Bài tập của bạn</h5>
                    @if (daNop)
                    {
                        <span class="status-badge bg-light text-success border border-success">
                            <i class="fas fa-check me-1"></i> Đã nộp
                        </span>
                    }
                    else if (!conHan)
                    {
                        <span class="status-badge bg-light text-danger border border-danger">
                            Trễ hạn
                        </span>
                    }
                </div>

                @if (daNop)
                {
                    <a href="@nopBai.LqvFile" target="_blank" class="file-item">
                        @{
                            var fileExt = System.IO.Path.GetExtension(nopBai.LqvFile ?? "").ToLower();
                            var icon = fileExt == ".pdf" ? "fa-file-pdf text-danger" : "fa-file-word text-primary";
                        }
                        <i class="fas @icon fa-2x me-3"></i>
                        <div class="overflow-hidden">
                            <div class="text-truncate fw-500" style="font-size: 0.9rem;">@nopBai.LqvFile</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Nhấp để xem tệp bài làm</div>
                        </div>
                    </a>
                }

                @if (conHan)
                {
                    <form asp-action="NopBai" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="baiTapId" value="@Model.LqvBaiTapId" />

                        <div class="mb-3">
                            <label class="dashed-upload">
                                <i class="fas fa-cloud-upload-alt fa-2x mb-2" style="color: #dadce0;"></i>
                                <div class="small fw-500">@(daNop ? "Thay đổi tệp đính kèm" : "Thêm tệp bài làm")</div>
                                <div class="text-muted" style="font-size: 0.7rem;">PDF, DOCX (Max 10MB)</div>
                                <input type="file" name="fileNop" hidden @(daNop ? "" : "required") onchange="updateFileName(this)" />
                            </label>
                            <div id="fileNameDisplay" class="small text-primary mt-2 fw-bold text-center"></div>
                        </div>

                        <div class="mb-3">
                            <textarea name="noiDung" class="form-control" rows="3"
                                      placeholder="Ghi chú cho giảng viên (không bắt buộc)..."
                                      style="font-size: 0.9rem; border-radius: 8px;">@nopBai?.LqvNoiDung</textarea>
                        </div>

                        <button type="submit" class="btn @(daNop ? "btn-outline-primary" : "btn-primary") w-100 fw-bold py-2 shadow-sm" style="border-radius: 8px;">
                            @(daNop ? "Nộp lại bài làm" : "Nộp bài ngay")
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-soft-warning border-0 p-3 mb-0" style="background: #fff8e1; border-radius: 8px;">
                        <div class="d-flex">
                            <i class="fas fa-info-circle mt-1 me-2 text-warning"></i>
                            <div class="small text-dark">
                                Đã kết thúc thời gian nộp bài. Bạn không thể thay đổi hoặc nộp mới bài tập này.
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 text-center">
                <a href="#" class="text-decoration-none small text-muted hover-primary">
                    <i class="fas fa-question-circle me-1"></i> Trợ giúp về nộp bài
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function updateFileName(input) {
        const display = document.getElementById('fileNameDisplay');
        if (input.files.length > 0) {
            display.innerHTML = '<i class="fas fa-file-import me-1"></i> Sẵn sàng: ' + input.files[0].name;
        }
    }
</script>