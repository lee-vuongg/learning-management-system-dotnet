@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvBaiTap>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Lớp học của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    /* Study4 Theme Colors */
    :root {
        --study4-primary: #3498db;
        --study4-navy: #2c3e50;
        --success-bg: #e6f4ea;
        --success-text: #1e7e34;
        --warning-bg: #fff3cd;
        --warning-text: #856404;
        --danger-bg: #f8d7da;
        --danger-text: #721c24;
    }

    .page-header {
        border-bottom: 2px solid #f1f1f1;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

    .assignment-card {
        border: 1px solid #edf2f7;
        border-radius: 12px;
        transition: all 0.25s ease-in-out;
        background: #fff;
        position: relative;
        overflow: hidden;
    }

        .assignment-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border-color: var(--study4-primary);
        }

    /* Soft Badges Study4 Style */
    .study4-badge {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 50px;
        display: inline-block;
    }

    .bg-success-soft {
        background-color: var(--success-bg);
        color: var(--success-text);
    }

    .bg-warning-soft {
        background-color: var(--warning-bg);
        color: var(--warning-text);
    }

    .bg-danger-soft {
        background-color: var(--danger-bg);
        color: var(--danger-text);
    }

    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background-color: #f0f7ff;
        color: var(--study4-primary);
    }

    .assignment-title {
        color: var(--study4-navy);
        font-size: 1.1rem;
        margin-bottom: 4px;
        transition: 0.2s;
    }

    .assignment-card:hover .assignment-title {
        color: var(--study4-primary);
    }

    .meta-info {
        font-size: 0.85rem;
        color: #718096;
    }
</style>

<div class="container py-4">
    <div class="page-header d-flex justify-content-between align-items-end">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2" style="background:none; padding:0;">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Khóa học</a></li>
                    <li class="breadcrumb-item active">Bài tập</li>
                </ol>
            </nav>
            <h3 class="fw-bold m-0" style="color: var(--study4-navy);">📚 Lộ trình học tập</h3>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border">@Model.Count() Bài tập</span>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            var daNop = item.LqvNopBaiTaps?.Any() ?? false;
            var quaHan = DateTime.Now > item.LqvHanNop;

            <div class="col-12 mb-3">
                <div class="card assignment-card shadow-sm">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="icon-box">
                                    <i class="fas fa-book-open fa-lg"></i>
                                </div>
                            </div>

                            <div class="col">
                                <h5 class="assignment-title fw-bold">
                                    <a asp-action="Details" asp-route-id="@item.LqvBaiTapId" class="text-decoration-none stretched-link">
                                        @item.LqvTieuDe
                                    </a>
                                </h5>
                                <div class="meta-info d-flex align-items-center flex-wrap">
                                    <span class="me-3"><i class="far fa-calendar-alt me-1"></i> Hạn nộp: @item.LqvHanNop.ToString("dd/MM/yyyy HH:mm")</span>
                                    <span><i class="fas fa-chalkboard me-1"></i> @item.LqvLopHoc?.LqvTenLop</span>
                                </div>
                            </div>

                            <div class="col-auto text-end">
                                @if (daNop)
                                {
                                    <div class="study4-badge bg-success-soft">
                                        <i class="fas fa-check-circle me-1"></i> Đã hoàn thành
                                    </div>
                                }
                                else if (quaHan)
                                {
                                    <div class="study4-badge bg-danger-soft">
                                        <i class="fas fa-exclamation-circle me-1"></i> Quá hạn nộp
                                    </div>
                                }
                                else
                                {
                                    <div class="study4-badge bg-warning-soft">
                                        <i class="far fa-clock me-1"></i> Đang diễn ra
                                    </div>
                                }
                            </div>

                            <div class="col-auto d-none d-md-block ms-2">
                                <i class="fas fa-chevron-right text-muted opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>