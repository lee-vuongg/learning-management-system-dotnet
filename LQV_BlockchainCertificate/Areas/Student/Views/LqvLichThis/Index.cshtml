@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvLichThi>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Lịch thi của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    var now = DateTime.Now;
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary rounded-3 p-2 me-3 text-white">
            <i class="bi bi-calendar-event fs-4"></i>
        </div>
        <h3 class="fw-bold m-0">Lịch thi của bạn</h3>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            var status = now < item.LqvBatDau ? "upcoming" : (now > item.LqvKetThuc ? "expired" : "live");
            
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden hover-shadow transition">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge @(status == "live" ? "bg-danger" : status == "upcoming" ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3">
                                @(status == "live" ? "● Đang diễn ra" : status == "upcoming" ? "Sắp diễn ra" : "Đã kết thúc")
                            </span>
                            <small class="text-muted"><i class="bi bi-tag"></i> @item.LqvLopHoc.LqvTenLop</small>
                        </div>
                        
                        <h5 class="fw-bold mb-3 text-dark">@item.LqvDeThi.LqvTenDeThi</h5>
                        
                        <div class="text-muted small mb-1">
                            <i class="bi bi-clock-history me-2"></i>Bắt đầu: @item.LqvBatDau.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="text-muted small mb-4">
                            <i class="bi bi-hourglass-split me-2"></i>Kết thúc: @item.LqvKetThuc.ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div class="d-grid gap-2 d-md-flex">
                            <a asp-action="Details" asp-route-id="@item.LqvLichThiId" class="btn btn-outline-primary rounded-pill flex-grow-1">Chi tiết</a>
                            @if (status == "live")
                            {
                                <a asp-area="Student" asp-controller="LqvLamBai" asp-action="Start" asp-route-lichThiId="@item.LqvLichThiId" 
                                   class="btn btn-primary rounded-pill flex-grow-1 fw-bold">Vào thi ngay</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .transition { transition: all 0.3s ease; }
    .btn-primary { background-color: #2c5891; border-color: #2c5891; }
    .btn-outline-primary { color: #2c5891; border-color: #2c5891; }
</style>