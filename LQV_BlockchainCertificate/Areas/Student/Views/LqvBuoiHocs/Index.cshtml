﻿
@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvBuoiHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Lịch học của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    /* Biến màu sắc chuẩn Study4 */
    :root {
        --s4-indigo: #4f46e5;
        --s4-indigo-light: #eef2ff;
        --s4-gray-dark: #1e293b;
        --s4-gray-text: #64748b;
        --s4-success: #10b981;
        --s4-success-light: #ecfdf5;
        --s4-bg: #f8fafc;
    }

    body {
        background-color: var(--s4-bg);
        font-family: 'Inter', sans-serif;
    }

    /* Card thiết kế chuẩn Study4 */
    .s4-card {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .s4-card:hover {
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08);
            transform: translateY(-4px);
            border-color: var(--s4-indigo);
        }

    /* Icon box phong cách hiện đại */
    .icon-box {
        width: 48px;
        height: 48px;
        background: var(--s4-indigo-light);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--s4-indigo);
        margin-right: 15px;
        font-size: 1.2rem;
    }

    /* Nút bấm */
    .btn-s4-primary {
        background-color: var(--s4-indigo);
        color: white !important;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-s4-primary:hover {
            background-color: #4338ca;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

    .btn-s4-outline {
        background-color: transparent;
        border: 1px solid #e2e8f0;
        color: var(--s4-gray-dark) !important;
        border-radius: 10px;
        font-weight: 500;
        padding: 10px 16px;
        transition: 0.2s;
    }

        .btn-s4-outline:hover {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
        }

    /* Badge trạng thái */
    .badge-open {
        background-color: var(--s4-success-light);
        color: var(--s4-success);
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1px solid #d1fae5;
    }

    .badge-closed {
        background-color: #f1f5f9;
        color: #94a3b8;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
    }

    .time-info {
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px;
        margin: 15px 0;
    }

    .class-title {
        font-weight: 700;
        color: var(--s4-gray-dark);
        font-size: 1.1rem;
        display: block;
        margin-bottom: 2px;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h3 class="fw-bold text-dark m-0"><i class="fas fa-graduation-cap me-2 text-indigo"></i>Lịch học của tôi</h3>
            <p class="text-muted mb-0">Theo dõi lịch học và thực hiện điểm danh GPS</p>
        </div>
        <div class="text-end">
            <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                <i class="fas fa-list-ul me-2 text-primary"></i>@Model.Count() Buổi học
            </span>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card s4-card shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <div class="icon-box">
                                    <i class="fas fa-calendar-day"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="class-title text-truncate" style="max-width: 180px;">@item.LqvLopHoc?.LqvTenLop</span>
                                    <small class="text-muted fw-500">
                                        <i class="far fa-calendar-alt me-1"></i> @item.LqvNgayHoc.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                                <div>
                                    @if (item.LqvDangMo == true)
                                    {
                                        <span class="badge-open">Đang mở</span>
                                    }
                                    else
                                    {
                                        <span class="badge-closed">Đã đóng</span>
                                    }
                                </div>
                            </div>

                            <div class="time-info">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">Thời gian:</span>
                                    <span class="fw-bold text-dark small">
                                        <i class="far fa-clock me-1 text-primary"></i>
                                        @item.LqvGioBatDau - @item.LqvGioKetThuc
                                    </span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3">
                                <div class="row g-2">
                                    <div class="col-4">
                                        <a asp-action="Details" asp-route-id="@item.LqvBuoiHocId"
                                           class="btn btn-s4-outline w-100 btn-sm">Chi tiết</a>
                                    </div>
                                    <div class="col-8">
                                        @if (item.LqvDangMo == true)
                                        {
                                            <a asp-area="Student"
                                               asp-controller="LqvDiemDanhGps"
                                               asp-action="CheckIn"
                                               asp-route-buoiHocId="@item.LqvBuoiHocId"
                                               class="btn btn-s4-primary w-100 btn-sm">
                                                <i class="fas fa-map-marker-alt"></i> Điểm danh GPS
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-light w-100 btn-sm text-muted" disabled style="border-radius: 10px;">
                                                <i class="fas fa-lock me-1"></i> Đã kết thúc
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white p-5 rounded-4 shadow-sm">
                    <img src="https://cdn-icons-png.flaticon.com/512/6598/6598519.png" style="width: 100px; opacity: 0.5" alt="empty">
                    <h5 class="mt-3 text-muted">Hiện tại bạn chưa có buổi học nào.</h5>
                </div>
            </div>
        }
    </div>
</div>