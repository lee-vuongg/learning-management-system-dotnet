@using LQV_BlockchainCertificate.Models.ViewModels
@model StudentDashboardViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Bảng điều khiển học tập";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* STUDY4 Design System */
    :root {
        --s4-blue: #007bff;
        --s4-blue-hover: #0056b3;
        --s4-bg-body: #f0f2f5;
        --s4-text-main: #1e293b;
        --s4-text-muted: #64748b;
        --s4-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        --s4-radius: 16px;
    }

    body {
        background-color: var(--s4-bg-body);
        font-family: 'Inter', sans-serif;
        color: var(--s4-text-main);
    }

    .dashboard-container {
        max-width: 1140px;
    }

    /* Profile Section */
    .s4-banner {
        background: #ffffff;
        border-radius: var(--s4-radius);
        padding: 2.5rem;
        box-shadow: var(--s4-card-shadow);
        border: 1px solid rgba(0,0,0,0.02);
        position: relative;
        overflow: hidden;
    }

        .s4-banner::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, rgba(0,123,255,0.05) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
        }

    .s4-avatar-wrapper {
        position: relative;
        display: inline-block;
    }

    .s4-avatar img {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .s4-welcome-text h2 {
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #0f172a;
    }

    .s4-tag {
        background: #f1f5f9;
        color: #475569;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        transition: all 0.2s;
    }

        .s4-tag:hover {
            background: #e2e8f0;
        }

    /* Stat Cards */
    .s4-stat-card {
        background: #fff;
        border-radius: var(--s4-radius);
        padding: 1.5rem;
        border: none;
        box-shadow: var(--s4-card-shadow);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
    }

        .s4-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
        }

    .s4-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .s4-stat-value {
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .s4-stat-label {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--s4-text-muted);
    }

    /* Content Cards */
    .s4-main-card {
        background: #fff;
        border-radius: var(--s4-radius);
        box-shadow: var(--s4-card-shadow);
        border: none;
        margin-bottom: 2rem;
    }

    .s4-card-header {
        padding: 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .s4-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
        color: #1e293b;
    }

    /* Table Improvements */
    .table thead th {
        background: #f8fafc;
        border-bottom: 1px solid #f1f5f9;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1rem 1.5rem;
    }

    .table tbody td {
        padding: 1.25rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    /* Custom Badges */
    .s4-badge {
        padding: 6px 12px;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .bg-success-soft {
        background-color: #dcfce7;
        color: #15803d;
    }

    .bg-warning-soft {
        background-color: #fef9c3;
        color: #a16207;
    }

    .bg-danger-soft {
        background-color: #fee2e2;
        color: #b91c1c;
    }

    .bg-blue-soft {
        background-color: #e0f2fe;
        color: #0369a1;
    }

    /* Buttons */
    .btn-s4-primary {
        background-color: var(--s4-blue);
        color: white;
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 20px;
        border: none;
        transition: all 0.2s;
    }

        .btn-s4-primary:hover {
            background-color: var(--s4-blue-hover);
            box-shadow: 0 4px 12px rgba(0,123,255,0.3);
            color: white;
        }

    @@media (max-width: 768px) {
        .s4-banner {
            padding: 1.5rem;
        }

        .s4-avatar img {
            width: 80px;
            height: 80px;
        }
    }
</style>

<div class="container py-5 dashboard-container">

    <div class="s4-banner d-md-flex align-items-center mb-5">
        <div class="s4-avatar-wrapper me-md-4 mb-3 mb-md-0 text-center">
            <div class="s4-avatar">
                <img src="@Model.AvtUrl" alt="Avatar" onerror="this.src='/img/default-avatar.png'">
            </div>
        </div>
        <div class="s4-welcome-text text-center text-md-start">
            <h2 class="mb-1">Chào buổi học, @Model.HoTen 👋</h2>
            <p class="text-muted mb-3">Hôm nay bạn muốn hoàn thành mục tiêu nào?</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                <div class="s4-tag"><i class="bi bi-person-vcard me-2"></i> @Model.MaSoSinhVien</div>
                <div class="s4-tag"><i class="bi bi-envelope-at me-2"></i> @Model.Email</div>
                <div class="s4-tag"><i class="bi bi-stars me-2"></i> Sinh viên tiêu biểu</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="s4-stat-card">
                <div class="s4-icon-box bg-warning-soft"><i class="bi bi-patch-check"></i></div>
                <div class="s4-stat-value">@Model.TongChungNhan</div>
                <div class="s4-stat-label">Chứng nhận</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="s4-stat-card">
                <div class="s4-icon-box bg-blue-soft"><i class="bi bi-file-earmark-code"></i></div>
                <div class="s4-stat-value">@Model.DanhSachBaiTap.Count(x => x.TrangThai == "Đã nộp")</div>
                <div class="s4-stat-label">Bài tập đã nộp</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="s4-stat-card">
                <div class="s4-icon-box bg-success-soft"><i class="bi bi-calendar2-check"></i></div>
                <div class="s4-stat-value">@Model.TongBuoiDaDiemDanh</div>
                <div class="s4-stat-label">Buổi đúng giờ</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="s4-stat-card">
                <div class="s4-icon-box bg-danger-soft"><i class="bi bi-calendar2-x"></i></div>
                <div class="s4-stat-value">@Model.TongBuoiVang</div>
                <div class="s4-stat-label">Vắng/Trễ</div>
            </div>
        </div>
    </div>

    <div class="s4-main-card">
        <div class="s4-card-header">
            <h5 class="s4-card-title">
                <i class="bi bi-list-task me-2 text-primary"></i> Bài tập cần hoàn thành
            </h5>
            <span class="badge bg-light text-dark rounded-pill">@Model.DanhSachBaiTap.Count mục</span>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Thông tin bài tập</th>
                        <th>Lớp học</th>
                        <th>Hạn chót</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachBaiTap != null && Model.DanhSachBaiTap.Any())
                    {
                        foreach (var bt in Model.DanhSachBaiTap)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@bt.TenBaiTap</div>
                                    <div class="text-muted small">Mã BT: #@bt.BaiTapId</div>
                                </td>
                                <td><span class="text-secondary">@bt.TenLopHoc</span></td>
                                <td>
                                    <div class="d-flex align-items-center small">
                                        <i class="bi bi-alarm me-2 text-danger"></i>
                                        @bt.Deadline.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    @switch (bt.TrangThai)
                                    {
                                        case "Đã nộp":
                                            <span class="s4-badge bg-success-soft">Đã nộp</span>
                                            break;
                                        case "Sắp đến hạn":
                                            <span class="s4-badge bg-warning-soft">Sắp đến hạn</span>
                                            break;
                                        case "Quá hạn":
                                            <span class="s4-badge bg-danger-soft">Quá hạn</span>
                                            break;
                                        default:
                                            <span class="s4-badge bg-light text-muted">Chưa nộp</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Student" asp-controller="LqvBaiTaps" asp-action="Details" asp-route-id="@bt.BaiTapId"
                                       class="btn-s4-primary btn-sm text-decoration-none">
                                        Chi tiết <i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="60" class="mb-3 opacity-50">
                                <p class="text-muted">Tuyệt vời! Bạn không còn bài tập nào tồn đọng.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="s4-main-card h-100">
                <div class="s4-card-header">
                    <h5 class="s4-card-title"><i class="bi bi-trophy me-2 text-warning"></i> Chứng nhận mới</h5>
                </div>
                <div class="p-3">
                    @if (Model.ChungNhanMoiNhat.Any())
                    {
                        foreach (var cn in Model.ChungNhanMoiNhat)
                        {
                            <div class="d-flex align-items-center p-3 mb-2 rounded-3 hover-bg-light border border-light shadow-sm">
                                <div class="bg-blue-soft rounded-circle p-3 me-3">
                                    <i class="bi bi-award fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">@cn.TenChungNhan</div>
                                    <div class="small text-muted">Cấp ngày: @cn.NgayCap.ToString("dd/MM/yyyy")</div>
                                </div>
                                <i class="bi bi-check-circle-fill text-success"></i>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">Bạn chưa có chứng chỉ nào.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="s4-main-card h-100">
                <div class="s4-card-header">
                    <h5 class="s4-card-title"><i class="bi bi-calendar-check me-2 text-danger"></i> Điểm danh gần đây</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <tbody>
                            @foreach (var dd in Model.LichSuDiemDanh.Take(5))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@dd.TenBuoiHoc</div>
                                        <div class="small text-muted">@dd.ThoiGianDiemDanh.ToString("HH:mm, dd/MM")</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (dd.TrangThai == "Đúng giờ")
                                        {
                                            <span class="s4-badge bg-success-soft">Đúng giờ</span>
                                        }
                                        else
                                        {
                                            <span class="s4-badge bg-danger-soft">@dd.TrangThai</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>