@model LQV_BlockchainCertificate.Models.DBModel.LqvChungNhan
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Xác Thực Thành Công";
    bool isPdf = ViewBag.IsPdf ?? false;
    Layout = isPdf ? null : "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";

    string verificationResult = ViewBag.KetQuaXacThuc ?? "Không có kết quả xác thực.";
    bool isSuccess = verificationResult.Contains("Hợp lệ");
    string qrCodeBase64 = ViewBag.QRCodeBase64;
    string signerName = "Lê Quốc Vương";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="~/css/InChunhNhan.css" rel="stylesheet" />

<style>
    :root {
        --s4-primary: #002d72; /* Study4 Navy */
        --s4-gold: #ccaa66;
        --s4-success: #2dce89;
    }

    body {
        font-family: 'Quicksand', sans-serif;
        background-color: #f4f7f6;
    }

    /* --- HIỆU ỨNG TRUYỀN CẢM HỨNG --- */
    .success-announcement {
        animation: fadeInUp 0.8s ease-out;
        background: white;
        border-radius: 20px;
        border-left: 10px solid var(--s4-success);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* --- CONTAINER CHỨNG CHỈ --- */
    .certificate-wrapper {
        perspective: 1000px;
        margin: 0 auto;
    }

    .certificate-container {
        padding: 50px;
        background-color: #fff;
        background-image: url('https://www.transparenttextures.com/patterns/white-paper.png');
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        position: relative;
        overflow: hidden;
        font-family: 'Times New Roman', serif;
        border: 20px solid transparent;
        border-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><path d="M0 0h100v100H0z" fill="white"/><path d="M0 0c20 0 30 10 50 10S80 0 100 0v10c-20 0-30 10-50 10S20 10 0 10V0zM0 90c20 0 30-10 50-10s30 10 50 10v10c-20 0-30-10-50-10S20 100 0 100V90zM0 0v10c10 0 10 20 10 40S10 90 0 90v10h10c0-20 10-30 10-50S10 20 10 0H0zM90 0v10c-10 0-10 20-10 40s0 40 10 40v10h10c0-20-10-30-10-50s-10-30-10-50H90z" fill="%23ccaa66"/></svg>') 30 round;
        transition: transform 0.5s;
    }

    .main-heading {
        font-family: 'Playfair Display', serif;
        color: var(--s4-primary);
        font-size: 3.8em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .sub-heading {
        letter-spacing: 5px;
        color: var(--s4-gold);
        font-weight: 600;
        margin-bottom: 30px;
    }

    .student-name {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        color: #111;
        border-bottom: 2px solid #eee;
        display: inline-block;
        padding: 0 50px;
        margin-bottom: 20px;
        font-style: italic;
    }

    /* --- BLOCKCHAIN INFO TABLE --- */
    .blockchain-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        border: 1px solid rgba(0, 45, 114, 0.1);
    }

    /* --- IN & PDF --- */
    @@page {
        size: A4 landscape;
        margin: 0;
    }

    @@media print {
        .non-pdf-actions, .success-announcement, nav, footer {
            display: none !important;
        }

        body {
            background: white;
            padding: 0;
        }

        .container-fluid {
            width: 100% !important;
            padding: 0 !important;
        }

        .certificate-container {
            box-shadow: none !important;
            border: 15px solid #ccaa66 !important;
        }
    }
</style>

<div class="container-fluid py-4">

    @if (!isPdf)
    {
        <div class="success-announcement shadow-sm p-4 mb-5 d-flex align-items-center">
            <div class="icon-box me-4">
                <i class="fas fa-award fa-4x text-success"></i>
            </div>
            <div>
                <h2 class="fw-bold text-dark mb-1">Chúc mừng bạn, @Model.LqvSinhVien?.LqvHoTen!</h2>
                <p class="text-muted mb-0">Hệ thống đã xác thực thành công chứng chỉ này trên Blockchain. Dữ liệu là minh bạch và không thể thay đổi.</p>
            </div>
            <div class="ms-auto">
                <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 me-2 shadow-sm">
                    <i class="fas fa-print me-2"></i>In chứng chỉ
                </button>
                <a asp-action="ExportPdf" asp-route-code="@Model.LqvMaChungNhanCode" class="btn btn-outline-dark rounded-pill px-4 shadow-sm">
                    <i class="fas fa-file-pdf me-2"></i>Tải PDF
                </a>
            </div>
        </div>
    }

    @if (isSuccess && Model != null)
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="certificate-wrapper">
                    <div class="certificate-container certificate-content-wrapper text-center">

                        <div class="mb-4">
                            <img src="~/img/logo.png" alt="Logo" style="max-height: 80px;" class="mb-2" />
                            <h6 class="text-uppercase fw-bold text-muted" style="letter-spacing: 3px;">Hệ thống Lộ trình phát triển Skill Map</h6>
                        </div>

                        <h1 class="main-heading">Chứng Chỉ</h1>
                        <p class="sub-heading text-uppercase">Hoàn thành chương trình</p>

                        <p class="congratulation-text mt-4">Chứng nhận học viên</p>
                        <h2 class="student-name">@Model.LqvSinhVien?.LqvHoTen</h2>

                        <p class="mb-1 text-muted">Đã xuất sắc hoàn thành khóa đào tạo kỹ năng</p>
                        <h3 class="fw-bold mb-5" style="color: var(--s4-primary); font-size: 1.8rem;">
                            "@Model.LqvKhoaHoc?.LqvTenKhoaHoc"
                        </h3>

                        <div class="row justify-content-center mb-5">
                            <div class="col-md-4 text-start border-end">
                                <p class="small mb-1 text-uppercase text-muted">Mã chứng nhận</p>
                                <p class="fw-bold">@Model.LqvMaChungNhanCode</p>
                                <p class="small mb-1 text-uppercase text-muted mt-3">Giảng viên hướng dẫn</p>
                                <p class="fw-bold">@Model.LqvKhoaHoc?.LqvGiangVien?.LqvHoTen</p>
                            </div>
                            <div class="col-md-4 text-start ps-md-4">
                                <p class="small mb-1 text-uppercase text-muted">Ngày cấp</p>
                                <p class="fw-bold">@Model.LqvNgayCap.ToString("dd/MM/yyyy")</p>
                                <p class="small mb-1 text-uppercase text-muted mt-3">Trạng thái hệ thống</p>
                                <p class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Đã xác thực Blockchain</p>
                            </div>
                        </div>

                        <div class="row mt-5 align-items-end">
                            <div class="col-4">
                                @if (!string.IsNullOrEmpty(qrCodeBase64))
                                {
                                    <img src="data:image/png;base64,@qrCodeBase64" alt="QR" style="width: 100px; border: 1px solid #f1f1f1; padding: 5px; background: white;" />
                                    <p class="text-xs text-muted mt-2">Quét để truy xuất Blockchain</p>
                                }
                            </div>
                            <div class="col-4">
                                <p class="mb-5 text-muted small">Mã định danh duy nhất (Hash ID)</p>
                                <code class="small text-break">@Model.LqvHashValue</code>
                            </div>
                            <div class="col-4">
                                <p class="mb-0 text-muted">Ngày @Model.LqvNgayCap.ToString("dd/MM/yyyy")</p>
                                <div class="my-3">
                                    <span style="font-family: 'Dancing Script', cursive; font-size: 2rem; color: #333;">@signerName</span>
                                </div>
                                <p class="fw-bold text-uppercase" style="border-top: 1px solid #333; display: inline-block; padding-top: 5px;">Đại diện Hội đồng đào tạo</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            @if (!isPdf)
            {
                <div class="col-lg-12 mt-5 non-pdf-actions">
                    <div class="blockchain-card p-4 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                            <h5 class="fw-bold text-primary mb-0">
                                <i class="fas fa-link me-2"></i>Bằng chứng minh bạch Blockchain
                            </h5>
                            <span class="badge bg-soft-primary text-primary px-3 py-2 rounded-pill">
                                Công nghệ: Ethereum/Quorum
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-borderless align-middle">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th>Thời gian</th>
                                        <th>Khối (Block)</th>
                                        <th>Mã giao dịch (Tx Hash)</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var gd in Model.LqvGiaoDichBlockchains.OrderByDescending(x => x.LqvGioTao))
                                    {
                                        <tr>
                                            <td class="small fw-bold">@gd.LqvGioTao.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="badge bg-light text-dark">#@gd.LqvBlockNumber</span></td>
                                            <td><code class="text-primary small text-break">@gd.LqvTxHash</code></td>
                                            <td class="text-center">
                                                <span class="text-success small fw-bold">
                                                    <i class="fas fa-check-double me-1"></i> @gd.LqvStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="text-center mt-5">
                        <a asp-action="VerifyForm" class="btn btn-link text-muted me-3">
                            <i class="fas fa-arrow-left me-2"></i>Xác thực mã khác
                        </a>
                        <a asp-action="Index" class="btn btn-link text-muted">
                            <i class="fas fa-history me-2"></i>Xem lịch sử của bạn
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>