@model LQV_BlockchainCertificate.Models.DBModel.LqvYeuCauCapChungChi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Tạo Yêu cầu Cấp Chứng chỉ";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="d-flex justify-content-center">
    <div class="card p-4 mx-auto shadow-lg" style="max-width: 600px; border-radius: 0.75rem;">
        <h1 class="h3 mb-4 text-primary text-center fw-bold border-bottom pb-2">@ViewData["Title"]</h1>

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <i class="fas fa-exclamation-triangle me-3 fs-5"></i>
                <div>
                    @TempData["InfoMessage"]
                </div>
            </div>
        }
        else
        {
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                    Vui lòng kiểm tra lại các trường bị lỗi.
                </div>

                <div class="mb-3">
                    <label asp-for="LqvKhoaHocId" class="form-label fw-bold">Khóa học</label>
                    <select asp-for="LqvKhoaHocId" class="form-select" asp-items="@(ViewData["LqvKhoaHocId"] as SelectList)" required>
                        <option value="">-- Chọn Khóa học đã hoàn thành --</option>
                    </select>
                    <span asp-validation-for="LqvKhoaHocId" class="text-danger"></span>
                </div>


                <div class="mb-4">
                    <label asp-for="LqvLyDoYeuCau" class="form-label fw-bold">Lý do Yêu cầu</label>
                    <textarea asp-for="LqvLyDoYeuCau" class="form-control" rows="4" placeholder="Ví dụ: Cần bổ sung vào hồ sơ xin việc, hoặc để lưu trữ" required></textarea>
                    <span asp-validation-for="LqvLyDoYeuCau" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-2"></i>Gửi Yêu cầu</button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}