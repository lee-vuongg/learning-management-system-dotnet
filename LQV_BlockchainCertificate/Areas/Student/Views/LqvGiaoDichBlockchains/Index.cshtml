@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvGiaoDichBlockchain>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Lịch sử Giao dịch Blockchain";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-primary">🔗 Lịch sử Giao dịch Blockchain</h4>
                    <p class="text-sm text-secondary mb-0">Các giao dịch liên quan đến chứng nhận của bạn.</p>
                </div>

                <hr class="mx-4">

                <div class="card-body px-0 pt-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Chứng nhận</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">TxHash</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Số Block</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thời gian</th>
                                    <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Trạng thái</th>
                                    <th class="text-secondary opacity-7"></th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex px-2 py-1">
                                                    <div class="d-flex flex-column justify-content-center">
                                                        <h6 class="mb-0 text-sm">@item.LqvChungNhan?.LqvKhoaHoc?.LqvTenKhoaHoc</h6>
                                                        <span class="text-xs text-secondary">Mã CN: @item.LqvChungNhan?.LqvMaChungNhanCode</span>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrEmpty(item.LqvTxHash))
                                                {
                                                    <a href="https://sepolia.etherscan.io/tx/item.LqvTxHash"
                                                       target="_blank" class="text-xs font-weight-bold text-info"
                                                       title="Xem trên Etherscan">
                                                        @(item.LqvTxHash.Length > 12 ? item.LqvTxHash.Substring(0, 10) + "..." : item.LqvTxHash)
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted text-xs">Chưa có</span>
                                                }
                                            </td>

                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">
                                                    @(item.LqvBlockNumber?.ToString() ?? "Chưa xác định")
                                                </span>
                                            </td>

                                            <td class="align-middle text-center text-sm">
                                                <span class="text-secondary text-xs font-weight-bold">
                                                    @item.LqvGioTao.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </td>

                                            <td class="align-middle text-center">
                                                @{
                                                    string status = item.LqvStatus ?? "Chờ xác nhận";
                                                    string badgeClass = status switch
                                                    {
                                                        "Thành công" => "bg-gradient-success",
                                                        "Đang xử lý" => "bg-gradient-warning",
                                                        _ => "bg-gradient-danger"
                                                    };
                                                }
                                                <span class="badge @badgeClass text-white">@status</span>
                                            </td>

                                            <td class="align-middle text-end pe-3">
                                                <a asp-action="Details" asp-route-id="@item.LqvMaGiaoDich"
                                                   class="text-primary font-weight-bold text-xs">
                                                    Xem chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-secondary py-4">
                                            Không tìm thấy giao dịch Blockchain nào.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
