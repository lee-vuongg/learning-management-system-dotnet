@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvDangKyLopHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Lớp học của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    .s4-card {
        border: none;
        border-radius: 12px;
        transition: 0.3s;
        background: #fff;
    }

        .s4-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }

    .btn-s4-outline {
        border: 2px solid #0056d2;
        color: #0056d2;
        font-weight: 600;
        border-radius: 8px;
    }

        .btn-s4-outline:hover {
            background: #0056d2;
            color: #fff;
        }

    .course-badge {
        background: #eef2ff;
        color: #4338ca;
        font-size: 0.75rem;
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 600;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0">📚 Lớp học của tôi</h3>
       @*  <a asp-action="DangKy" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Đăng ký lớp mới
        </a> *@
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="80" class="mb-3 opacity-50">
            <p class="text-muted">Bạn chưa đăng ký lớp học nào. Hãy bắt đầu ngay!</p>
            <a asp-action="DangKy" class="btn btn-s4-outline px-4 mt-2">Khám phá khóa học</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card s4-card shadow-sm h-100">
                        <div class="card-body p-4">
                            <span class="course-badge mb-3 d-inline-block">
                                @item.LqvLopHoc.LqvKhoaHoc?.LqvTenKhoaHoc
                            </span>
                            <h5 class="fw-bold text-dark mb-2">@item.LqvLopHoc.LqvTenLop</h5>
                            <p class="text-muted small">
                                <i class="far fa-calendar-alt me-2"></i>Ngày đăng ký: @item.LqvNgayDangKy?.ToString("dd/MM/yyyy")
                            </p>
                            <div class="mt-4">
                                <a asp-controller="LqvLopHocs" asp-action="Details" asp-route-id="@item.LqvLopHocId"
                                   class="btn btn-s4-outline w-100">
                                    Vào học ngay <i class="fas fa-arrow-right ms-2 small"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>