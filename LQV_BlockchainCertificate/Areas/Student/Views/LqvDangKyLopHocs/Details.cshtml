@model LQV_BlockchainCertificate.Models.DBModel.LqvDangKyLopHoc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết lớp học";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h4 class="fw-bold text-primary mb-0">📘 Thông tin đăng ký</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold">Lớp học</label>
                            <p class="h5 fw-bold text-dark">@Model.LqvLopHoc?.LqvTenLop</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold">Trạng thái</label>
                            <div><span class="badge bg-success-soft text-success px-3 py-2 rounded-pill">Đang theo học</span></div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold">Khóa học</label>
                            <p class="text-dark">@Model.LqvLopHoc?.LqvKhoaHoc?.LqvTenKhoaHoc</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold">Ngày đăng ký</label>
                            <p class="text-dark">@Model.LqvNgayDangKy?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-3">
                        <a asp-controller="LqvLopHocs" asp-action="Details" asp-route-id="@Model.LqvLopHocId"
                           class="btn btn-primary px-4 py-2 rounded-3 shadow-sm flex-grow-1">
                            🚀 Vào lớp học ngay
                        </a>
                        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft {
        background: #dcfce7;
        color: #166534;
    }

    .bg-soft-primary {
        background: #e0e7ff;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>