@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Study4 Student Portal</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            /* Palette Study4 Modern */
            --s4-primary: #2c5891;
            --s4-primary-light: #eef2f7;
            --s4-accent: #2a9d8f;
            --s4-accent-soft: rgba(42, 157, 143, 0.1);
            --s4-bg: #f8fafc;
            --s4-nav-bg: #ffffff;
            --s4-text: #1e293b;
            --s4-text-light: #64748b;
            --s4-border: #e2e8f0;
            --s4-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
            --s4-card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

        [data-theme="dark"] {
            --s4-primary: #38bdf8;
            --s4-primary-light: #1e293b;
            --s4-bg: #0f172a;
            --s4-nav-bg: #1e293b;
            --s4-text: #f1f5f9;
            --s4-text-light: #94a3b8;
            --s4-border: #334155;
            --s4-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        body {
            background: var(--s4-bg);
            color: var(--s4-text);
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            -webkit-font-smoothing: antialiased;
        }

        /* --- Custom Scrollbar --- */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--s4-bg);
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        /* --- Navbar Style --- */
        header.navbar {
            background: var(--s4-nav-bg) !important;
            border-bottom: 1px solid var(--s4-border);
            box-shadow: var(--s4-shadow);
            padding: 0.5rem 0;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        .navbar-brand img {
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover img {
            transform: scale(1.05);
        }

        .nav-link {
            color: var(--s4-text) !important;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1.2rem !important;
            border-radius: 10px;
            margin: 0 3px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .nav-link:hover {
                color: var(--s4-primary) !important;
                background: var(--s4-primary-light);
            }

            .nav-link.active {
                color: white !important;
                background: var(--s4-primary) !important;
                box-shadow: 0 4px 12px rgba(44, 88, 145, 0.2);
            }

        /* --- Dropdown Style --- */
        .dropdown-menu {
            border: 1px solid var(--s4-border);
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            padding: 10px;
            margin-top: 15px !important;
            background: var(--s4-nav-bg);
        }

        .dropdown-item {
            padding: 12px 16px;
            border-radius: 10px;
            font-weight: 500;
            font-size: 0.9rem;
            color: var(--s4-text);
            transition: all 0.2s;
        }

            .dropdown-item:hover {
                background: var(--s4-primary-light);
                color: var(--s4-primary);
                transform: translateX(5px);
            }

            .dropdown-item i {
                width: 24px;
                font-size: 1.1rem;
                color: var(--s4-text-light);
            }

        /* --- User Profile Toggle --- */
        .user-dropdown-toggle {
            background: linear-gradient(135deg, var(--s4-primary), #4a90e2) !important;
            color: white !important;
            border-radius: 12px !important;
            padding: 8px 20px !important;
            font-weight: 700 !important;
            border: none !important;
        }

        /* --- Theme Toggle --- */
        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            border: 1px solid var(--s4-border);
            background: var(--s4-nav-bg);
            color: var(--s4-text);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 15px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .theme-toggle:hover {
                border-color: var(--s4-primary);
                color: var(--s4-primary);
                background: var(--s4-primary-light);
            }

        /* --- Main Content Area --- */
        .main-content {
            flex: 1;
            padding: 40px 0 80px;
            animation: slideUp 0.4s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- Footer --- */
        footer {
            background: var(--s4-nav-bg);
            border-top: 1px solid var(--s4-border);
            padding: 40px 0;
            color: var(--s4-text-light);
            margin-top: auto;
        }

        .footer-logo {
            font-weight: 800;
            color: var(--s4-primary);
            font-size: 1.25rem;
        }

        /* --- Mobile Optimization --- */
        @@media (max-width: 991.98px) {
            .navbar-collapse {
                background: var(--s4-nav-bg);
                padding: 20px;
                border-radius: 20px;
                margin-top: 15px;
                border: 1px solid var(--s4-border);
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            }

            .nav-link {
                margin: 5px 0;
            }

            .theme-toggle {
                margin: 15px 0 0 0;
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <header class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/Student/Home">
                <img src="/img/logo.png" style="height:45px; width:auto; margin-right:12px; border-radius:8px;" alt="Logo" />
                <span class="fw-800 fs-4 d-none d-sm-inline" style="letter-spacing: -1px; color: var(--s4-primary);">STUDY<span style="color:var(--s4-accent)">4</span></span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="bi bi-grid-fill fs-3 text-primary"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item">
                        <a class="nav-link active" href="/Student/Home">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-mortarboard"></i> Học tập
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg">
                            <li><a class="dropdown-item" href="/Student/LqvKhoaHocs"><i class="bi bi-journal-bookmark me-2"></i> Khóa học của tôi</a></li>
                           @*  <li><a class="dropdown-item" href="/Student/LqvDangKyLopHocs"><i class="bi bi-plus-circle me-2"></i> Đăng ký lớp học</a></li> *@
                            <li><a class="dropdown-item" href="/Student/LqvLopHocs"><i class="bi bi-people me-2"></i> Lớp học của tôi</a></li>
                            <li><hr class="dropdown-divider opacity-50"></li>
                            <li><a class="dropdown-item" href="/Student/LqvBuoiHocs"><i class="bi bi-calendar3 me-2"></i> Lịch học chi tiết</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvDiemDanhGps"><i class="bi bi-geo-alt me-2"></i> Điểm danh GPS</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-pencil-square"></i> Thi cử
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg">
                            <li><a class="dropdown-item" href="/Student/LqvBaiTaps"><i class="bi bi-list-check me-2"></i> Bài tập về nhà</a></li>
                           @*  <li><a class="dropdown-item" href="/Student/LqvNopBais"><i class="bi bi-cloud-upload me-2"></i> Nộp bài online</a></li> *@
                            <li><hr class="dropdown-divider opacity-50"></li>
                            <li><a class="dropdown-item" href="/Student/LqvLamBai/Index"><i class="bi bi-lightning-charge me-2"></i> Kỳ thi trực tuyến</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvLichThis"><i class="bi bi-clock-history me-2"></i> Lịch thi dự kiến</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvBaiLams"><i class="bi bi-graph-up-arrow me-2"></i> Kết quả & Bảng điểm</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-patch-check"></i> Chứng chỉ
                        </a>
                        <ul class="dropdown-menu border-0 shadow-lg">
                            <li><a class="dropdown-item" href="/Student/LqvChungNhans"><i class="bi bi-award me-2"></i> Chứng chỉ của tôi</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvYeuCauCapChungChis"><i class="bi bi-send me-2"></i> Đăng ký cấp mới</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvXacThucChungNhans"><i class="bi bi-search me-2"></i> Tra cứu xác thực</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvGiaoDichBlockchains"><i class="bi bi-box-seam me-2"></i> Blockchain Explorer</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown ms-lg-3">
                        <a class="nav-link dropdown-toggle user-dropdown-toggle mt-lg-0 mt-3" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> @User.Identity?.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                            <li><a class="dropdown-item" asp-area="Auth" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-badge me-2"></i> Hồ sơ cá nhân</a></li>
                            <li><a class="dropdown-item" asp-area="Auth" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i> Bảo mật tài khoản</a></li>
                            <li><a class="dropdown-item" href="/Student/LqvYeuCauHoTroes"><i class="bi bi-question-circle me-2"></i> Trung tâm trợ giúp</a></li>
                            <li><hr class="dropdown-divider opacity-50"></li>
                            <li><a class="dropdown-item text-danger fw-bold" asp-area="Auth" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <button class="theme-toggle" id="themeToggle" title="Chế độ sáng/tối">
                            <i class="bi bi-moon-stars-fill"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="footer-logo mb-2">STUDY4 <span class="text-accent" style="color:var(--s4-accent)">CERTIFICATE</span></div>
                    <p class="mb-0 small text-muted">Hệ thống quản lý và xác thực chứng chỉ ứng dụng công nghệ Blockchain.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="social-links mb-3">
                        <a href="#" class="text-muted me-3 fs-5"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-muted me-3 fs-5"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="text-muted fs-5"><i class="bi bi-github"></i></a>
                    </div>
                    <div class="small text-muted">
                        © 2026 LQV Vision. Toàn bộ bản quyền được bảo lưu.
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const root = document.documentElement;
        const btn = document.getElementById("themeToggle");
        const icon = btn.querySelector("i");

        const updateUI = (theme) => {
            root.setAttribute("data-theme", theme);
            icon.className = theme === "dark" ? "bi bi-sun-fill" : "bi bi-moon-stars-fill";
            localStorage.setItem("theme", theme);
        };

        const saved = localStorage.getItem("theme") || "light";
        updateUI(saved);

        btn.onclick = () => {
            const current = root.getAttribute("data-theme");
            updateUI(current === "light" ? "dark" : "light");
        };

        // Auto-active Link highlight
        document.querySelectorAll('.nav-link').forEach(link => {
            if(link.getAttribute('href') === window.location.pathname) {
                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                link.classList.add('active');
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>