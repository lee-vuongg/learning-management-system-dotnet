@using LQV_BlockchainCertificate.Models.ViewModels
@model IEnumerable<ChungNhanHienThiVM>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chứng nhận đã cấp";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    .s4-certificate-card {
        border: none;
        border-radius: 16px;
        background: #fff;
    }

    .table thead th {
        border-bottom: 1px solid #edf2f7;
        color: #718096;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .table tbody td {
        vertical-align: middle;
        border-bottom: 1px solid #f7fafc;
        padding: 1.25rem 1rem;
    }

    .status-pill {
        border-radius: 8px;
        padding: 5px 12px;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .status-success {
        background-color: #e6fffa;
        color: #2c7a7b;
    }

    .status-warning {
        background-color: #fffaf0;
        color: #975a16;
    }

    .course-icon {
        width: 40px;
        height: 40px;
        background: #ebf4ff;
        color: #3182ce;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">📜 Chứng nhận của tôi</h3>
            <p class="text-muted small">Bạn đã hoàn thành <span class="text-primary fw-bold">@Model.Count()</span> khóa học và nhận chứng chỉ.</p>
        </div>
    </div>

    <div class="card s4-certificate-card shadow-sm">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Khóa học</th>
                        <th>Mã chứng nhận</th>
                        <th class="text-center">Ngày cấp</th>
                        <th class="text-center">Trạng thái Blockchain</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="course-icon me-3">
                                            <i class="fas fa-certificate"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.TenChungNhan</div>
                                            <div class="text-muted small">ID: #@item.LqvMaChungNhan</div>
                                        </div>
                                    </div>
                                </td>
                                <td><code class="text-primary fw-bold">@item.MaChungNhanCode</code></td>
                                <td class="text-center text-muted small">@item.NgayCap.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    @{
                                        string statusClass = item.TrangThaiXacThuc == "Đã ghi chain" ? "status-success" : "status-warning";
                                        string icon = item.TrangThaiXacThuc == "Đã ghi chain" ? "fa-link" : "fa-hourglass-half";
                                    }
                                    <span class="status-pill @statusClass">
                                        <i class="fas @icon me-1 small"></i> @item.TrangThaiXacThuc
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.LqvMaChungNhan" class="btn btn-light btn-sm rounded-pill px-3 fw-bold">
                                        Xem & Xác thực
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <p class="text-muted mb-0">Bạn chưa có chứng nhận nào khả dụng.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>