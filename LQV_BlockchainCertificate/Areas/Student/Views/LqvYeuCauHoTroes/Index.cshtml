@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvYeuCauHoTro>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Lịch sử Yêu cầu Hỗ trợ";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    /* CSS Neon Dark Mode */
    :root {
        --color-card-bg: #1c233a;
        --color-text-light: #e0e7ff;
        --color-neon-blue: #4fd1c5;
        --color-dark-bg: #0d1222;
        --border-radius-lg: 12px;
        --color-text-muted: #8c97b8;
        --gradient-primary: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
        --color-neon-red: #f56565;
    }

    .table-custom {
        background-color: var(--color-card-bg);
        color: var(--color-text-light);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

        .table-custom th {
            color: var(--color-neon-blue);
            border-bottom: 2px solid #323b6b;
        }

        .table-custom td {
            border-top: 1px solid #273059;
        }

    .table-hover tbody tr:hover {
        background-color: #1a2455;
    }

    .btn-neon-primary {
        background: var(--gradient-primary);
        border: none;
        color: var(--color-dark-bg);
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-neon-primary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: var(--color-dark-bg);
        }

    .btn-neon-danger {
        background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
        border: none;
        color: #fff;
        font-weight: 600;
        transition: all 0.3s;
    }

    /* Badge trạng thái */
    .badge-custom {
        display: inline-block;
        padding: 0.35em 0.65em;
        font-size: 0.8em;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: 0.375rem;
    }

    .badge-pending {
        background-color: #f6ad55 !important; /* Vàng Cam - Chờ xử lý */
        color: #000 !important;
    }

    .badge-processing {
        background-color: #38b2ac !important; /* Xanh ngọc - Đang xử lý */
        color: #fff !important;
    }

    .badge-resolved {
        background-color: #48bb78 !important; /* Xanh lá - Đã xử lý */
        color: #000 !important;
    }

    /* Alert cho TempData */
    .alert-neon-success {
        background-color: #2b6c67;
        color: #e0e7ff;
        border-color: var(--color-neon-blue);
    }

    .alert-neon-warning {
        background-color: #725114;
        color: #fff3cd;
        border-color: #f6ad55;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold" style="color: var(--color-neon-blue);">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-neon-primary"><i class="fas fa-plus me-2"></i>Gửi Yêu cầu mới</a>
</div>

@* Hiển thị TempData *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-neon-success alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-neon-warning alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show card shadow-sm mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive card-custom p-3">
    <table class="table table-custom table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>#ID</th>
                <th>@Html.DisplayNameFor(model => model.LqvNoiDung)</th>
                <th>@Html.DisplayNameFor(model => model.LqvThoiGianGui)</th>
                <th>@Html.DisplayNameFor(model => model.LqvTrangThai)</th>
                <th>Phản hồi Admin</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // Xác định class cho trạng thái
                string statusClass = item.LqvTrangThai switch
                {
                    "Chờ xử lý" => "badge-pending",
                    "Đang xử lý" => "badge-processing",
                    "Đã xử lý" => "badge-resolved",
                    _ => "bg-secondary"
                };

                // Xác định khả năng chỉnh sửa/xóa
                bool isEditable = item.LqvTrangThai == "Chờ xử lý";

                <tr>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.LqvId)</strong>
                    </td>
                    <td style="max-width: 350px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.LqvNoiDung">
                        @{
                            string displayNoiDung = item.LqvNoiDung ?? "";
                            string truncatedNoiDung = displayNoiDung.Length > 80 ? displayNoiDung.Substring(0, 80) + "..." : displayNoiDung;
                        }
                        @truncatedNoiDung
                    </td>
                    <td>
                        @(item.LqvThoiGianGui.HasValue ? item.LqvThoiGianGui.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                    </td>
                    <td>
                        <span class="badge-custom @statusClass">
                            @Html.DisplayFor(modelItem => item.LqvTrangThai)
                        </span>
                    </td>
                    <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.LqvPhanHoi">
                        @{
                            string displayPhanHoi = item.LqvPhanHoi ?? "";
                            if (string.IsNullOrEmpty(displayPhanHoi))
                            {
                                <span class="text-muted fst-italic">Chưa có phản hồi</span>
                            }
                            else
                            {
                                string truncatedPhanHoi = displayPhanHoi.Length > 50 ? displayPhanHoi.Substring(0, 50) + "..." : displayPhanHoi;
                                <i class="fas fa-check-circle text-success me-1"></i>
                                @truncatedPhanHoi
                            }
                        }
                    </td>
                    <td class="text-center">
                        <div class="d-flex gap-2 justify-content-center">
                            @if (isEditable)
                            {
                                <a asp-action="Edit" asp-route-id="@item.LqvId" class="btn btn-sm btn-neon-primary" title="Chỉnh sửa"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.LqvId" class="btn btn-sm btn-neon-danger" title="Hủy yêu cầu"><i class="fas fa-trash-alt"></i></a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary disabled" title="Không thể chỉnh sửa"><i class="fas fa-ban"></i></button>
                            }
                            <a asp-action="Details" asp-route-id="@item.LqvId" class="btn btn-sm btn-outline-info" style="color:var(--color-neon-blue); border-color:var(--color-neon-blue);" title="Xem chi tiết & Phản hồi"><i class="fas fa-eye"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="text-center p-5 rounded" style="background-color: #1a2455; color: var(--color-text-muted);">
            <i class="fas fa-inbox fa-3x mb-3"></i>
            <p class="fw-bold">Bạn chưa gửi yêu cầu hỗ trợ nào.</p>
            <a asp-action="Create" class="btn btn-neon-primary mt-2">Gửi Yêu cầu Đầu tiên</a>
        </div>
    }
</div>