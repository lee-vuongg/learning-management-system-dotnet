@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvLopHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Lớp học của tôi";
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
}

<style>
    :root {
        --s4-primary: #002d72;
        --s4-soft-blue: #eef2f7;
    }

    .course-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        background: #fff;
        overflow: hidden;
        height: 100%;
    }

        .course-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.1) !important;
        }

    .course-image {
        height: 160px;
        background: linear-gradient(135deg, #002d72 0%, #0056b3 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .course-image i {
            font-size: 4rem;
            color: rgba(255,255,255,0.2);
        }

    .course-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(255,255,255,0.9);
        color: var(--s4-primary);
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .instructor-info {
        display: flex;
        align-items: center;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .instructor-avatar {
        width: 32px;
        height: 32px;
        background: #ddd;
        border-radius: 50%;
        margin-right: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }
</style>

<div class="mb-4 d-flex align-items-center">
    <div class="bg-primary p-2 rounded-3 me-3">
        <i class="fas fa-graduation-cap text-white fs-4"></i>
    </div>
    <div>
        <h3 class="fw-bold mb-0">Khóa học của tôi</h3>
        <p class="text-muted mb-0">Tiếp tục hành trình chinh phục kỹ năng mới</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card course-card shadow-sm">
                <div class="course-image">
                    <span class="course-badge">@item.LqvKhoaHoc?.LqvTenKhoaHoc</span>
                    <i class="fas fa-book-open"></i>
                    <div class="position-absolute bottom-0 start-0 p-3 w-100">
                        <h5 class="text-white fw-bold mb-0">@item.LqvTenLop</h5>
                    </div>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3 text-truncate-2" style="height: 40px;">
                        @(string.IsNullOrEmpty(item.LqvMoTa) ? "Chưa có mô tả cho lớp học này." : item.LqvMoTa)
                    </p>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-muted"><i class="far fa-calendar-alt me-1"></i> @item.LqvNgayTao?.ToString("dd/MM/yyyy")</span>
                        <span class="small fw-bold text-success">Đang diễn ra</span>
                    </div>

                    <div class="instructor-info">
                        <div class="instructor-avatar text-white bg-secondary">
                            <i class="fas fa-user"></i>
                        </div>
                        <span class="small fw-medium text-dark">GV: @item.LqvGiangVien?.LqvHoTen</span>
                    </div>

                    <a asp-action="Details" asp-route-id="@item.LqvLopHocId" class="btn btn-primary w-100 mt-3 rounded-pill fw-bold">
                        Vào học ngay
                    </a>
                </div>
            </div>
        </div>
    }
</div>