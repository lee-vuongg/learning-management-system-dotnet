@model LQV_BlockchainCertificate.Models.DBModel.LqvBaiLam
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    var cauHois = Model.LqvLichThi?
                         .LqvDeThi?
                         .LqvBoCauHoi?
                         .LqvCauHois?
                         .ToList() ?? new List<LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi>();
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --s4-primary: #35509a;
        --s4-primary-hover: #2a407a;
        --s4-primary-light: #f0f3ff;
        --s4-secondary: #64748b;
        --s4-success: #22c55e;
        --s4-danger: #ef4444;
        --s4-warning: #f59e0b;
        --s4-bg: #fdfdfe; /* Nền trắng hơi xanh cực nhẹ của Study4 */
        --s4-border: #e5e7eb;
        --radius-lg: 12px;
        --radius-md: 8px;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    body {
        background-color: var(--s4-bg);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: #334155;
        line-height: 1.6;
    }

    /* Header thanh mảnh, hiện đại */
    .exam-top-bar {
        background: #ffffff;
        border-bottom: 2px solid var(--s4-primary-light);
        position: sticky;
        top: 0;
        z-index: 1000;
        padding: 12px 0;
    }

    /* Card giám sát Camera - Tối giản hơn */
    .proctor-card {
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--s4-border);
        overflow: hidden;
    }

    .proctor-header {
        background: #f8fafc;
        padding: 10px 15px;
        border-bottom: 1px solid var(--s4-border);
        font-size: 0.9rem;
    }

    /* Card câu hỏi */
    .question-card {
        background: #ffffff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--s4-border);
        padding: 25px;
        margin-bottom: 24px;
        transition: border-color 0.2s ease;
    }

        .question-card:hover {
            border-color: #cbd5e1;
        }

    .question-number {
        display: inline-flex;
        align-items: center;
        background: var(--s4-primary);
        color: #fff;
        font-weight: 600;
        padding: 2px 12px;
        border-radius: 6px;
        font-size: 0.8rem;
        margin-bottom: 15px;
    }

    .question-content {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 20px;
    }

    /* Đáp án - Tinh chỉnh giống Study4 nhất */
    .option-item {
        margin-bottom: 10px;
    }

        .option-item input[type="radio"] {
            display: none;
        }

        .option-item label {
            display: flex;
            align-items: center;
            padding: 12px 18px;
            border: 1px solid var(--s4-border);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            font-weight: 400;
            color: #475569;
            background: #fff;
            width: 100%;
            position: relative;
        }

            .option-item label:hover {
                background-color: #f1f5f9;
                border-color: #cbd5e1;
            }

        .option-item input[type="radio"]:checked + label {
            background-color: var(--s4-primary-light);
            border-color: var(--s4-primary);
            color: var(--s4-primary);
            font-weight: 500;
        }

        .option-item label::before {
            content: "";
            width: 18px;
            height: 18px;
            border: 2px solid #cbd5e1;
            border-radius: 50%;
            margin-right: 12px;
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .option-item input[type="radio"]:checked + label::before {
            border-color: var(--s4-primary);
            background: radial-gradient(var(--s4-primary) 40%, transparent 45%);
        }

    /* Sidebar Điều hướng câu hỏi */
    .card-navigation {
        border-radius: var(--radius-lg);
        border: 1px solid var(--s4-border);
        background: #fff;
    }

    .nav-box {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid var(--s4-border);
        background: #fff;
        text-decoration: none;
        color: var(--s4-secondary);
        font-weight: 500;
        font-size: 0.85rem;
        transition: all 0.2s;
    }

        .nav-box.answered {
            background-color: var(--s4-primary) !important;
            color: #fff !important;
            border-color: var(--s4-primary);
        }

        .nav-box:hover:not(.answered) {
            background: var(--s4-primary-light);
            color: var(--s4-primary);
            border-color: var(--s4-primary);
        }

    /* Timer & Nút nộp bài */
    .timer-display {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--s4-danger);
        letter-spacing: 1px;
    }

    .btn-submit-exam {
        background-color: var(--s4-primary);
        color: white;
        border: none;
        padding: 8px 24px;
        border-radius: 6px;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-submit-exam:hover {
            background-color: var(--s4-primary-hover);
            color: #fff;
        }

    /* Textarea tự luận */
    textarea.form-control {
        border: 1px solid var(--s4-border);
        border-radius: var(--radius-md);
        resize: vertical;
    }

        textarea.form-control:focus {
            border-color: var(--s4-primary);
            box-shadow: 0 0 0 3px var(--s4-primary-light);
        }
</style>

<div class="exam-top-bar">
    <div class="container-fluid px-md-5">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-truncate" style="max-width: 400px; color: var(--s4-primary);">
                <i class="fas fa-file-alt me-2"></i>
                @Model.LqvLichThi.LqvDeThi.LqvTenDeThi
            </h5>

            <div class="d-flex align-items-center">
                <div class="me-4 d-none d-md-block text-end">
                    <div class="text-muted small">Tiến độ làm bài</div>
                    <div id="progress-text" class="fw-bold text-dark">0/@cauHois.Count</div>
                </div>

                <div class="px-3 border-start">
                    <div id="timer" class="timer-display">00:00</div>
                </div>

                <button type="button" onclick="confirmSubmit()" class="btn btn-submit-exam ms-3">
                    Nộp bài
                </button>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid px-md-5 mt-3">
    <div class="card p-3 shadow-sm">
        <h6 class="fw-bold mb-2">📷 Giám sát Camera</h6>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <select id="cameraSelect" class="form-select w-auto"></select>

            <button type="button"
                    id="btnStartCam"
                    class="btn btn-sm btn-primary">
                Bật Camera
            </button>
        </div>

        <video id="video"
               width="280"
               height="200"
               autoplay
               muted
               playsinline
               style="margin-top:10px;border-radius:8px;border:1px solid #ddd;">
        </video>

        <canvas id="canvas" style="display:none;"></canvas>
    </div>
</div>
<div class="container-fluid py-4 px-md-5">
    <div class="row">
        <div class="col-lg-9">
            <form asp-area="Student" asp-controller="LqvLamBai" asp-action="Submit" method="post" id="examForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="baiLamId" value="@Model.LqvBaiLamId" />

                @for (int i = 0; i < cauHois.Count; i++)
                {
                    var item = cauHois[i];
                    <div class="question-card" id="q-@(i+1)">
                        <span class="question-number">Câu hỏi @(i + 1)</span>

                        <div class="fw-bold fs-5 mb-4 text-dark">
                            @item.LqvNoiDung
                            <small class="text-muted fw-normal ms-2">(@item.LqvDiem điểm)</small>
                        </div>

                        @if (item.LqvLoai == "TracNghiem")
                        {
                            <div class="options-container">
                                @foreach (var da in item.LqvDapAns)
                                {
                                    <div class="option-item">
                                        <input type="radio"
                                               id="da-@da.LqvDapAnId"
                                               name="answers[@item.LqvCauHoiId]"
                                               value="@da.LqvDapAnId"
                                               onchange="markAnswered(@(i+1))" />
                                        <label for="da-@da.LqvDapAnId">@da.LqvNoiDung</label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <textarea class="form-control"
                                      name="tuLuan[@item.LqvCauHoiId]"
                                      rows="5"
                                      placeholder="Nhập nội dung câu trả lời của bạn tại đây..."
                                      oninput="markAnswered(@(i+1))"></textarea>
                        }
                    </div>
                }
            </form>
        </div>

        <div class="col-lg-3">
            <div class="sticky-top" style="top: 90px;">
                <div class="card card-navigation">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 d-flex justify-content-between align-items-center">
                            Danh sách câu hỏi
                            <span class="badge bg-light text-primary">@cauHois.Count câu</span>
                        </h6>
                        <hr class="text-muted opacity-25">
                        <div class="d-flex flex-wrap gap-2">
                            @for (int i = 1; i <= cauHois.Count; i++)
                            {
                                <a href="#q-@i" id="nav-q-@i" class="nav-box">@i</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@mediapipe/face_detection/face_detection.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@mediapipe/camera_utils/camera_utils.js"></script>

    <script>

        // ================= CONFIG =================
        const baiLamId = @Model.LqvBaiLamId;
        const examRoom = "exam_@Model.LqvLichThiId";
        const studentId = "@User.Identity.Name";

        let currentStream = null;
        let faceDetector = null;
        let aiCamera = null;
        let faceAIStarted = false;

        let noFaceCount = 0;
        let multiFaceCount = 0;
        let lookAwayCount = 0;

        // ===== ANTI FALSE POSITIVE =====
        let examStartTime = 0;
        const GRACE_PERIOD = 8000; // 8 giây đầu không phạt

        let hasDetectedFace = false;

        let lastViolationTime = 0;
        const VIOLATION_COOLDOWN = 5000; // 5 giây giữa các lần phạt

        // ================= SIGNALR =================
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/proctorHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(() => {
            connection.invoke("JoinExamRoom", examRoom);
        });

        connection.onreconnected(() => {
            connection.invoke("JoinExamRoom", examRoom);
        });

        // ================= GỬI FRAME REALTIME =================
        setInterval(async () => {

            if (!currentStream) return;
            if (connection.state !== signalR.HubConnectionState.Connected) return;

            try {
                await connection.invoke(
                    "SendLiveFrame",
                    "@Model.LqvUserId",
                    captureImage(),
                    examRoom
                );
            } catch (err) {
                console.error("SendLiveFrame error:", err);
            }

        }, 3000);
          // ================= LOAD CAMERA =================
        async function loadCameras() {

            try {
                const temp = await navigator.mediaDevices.getUserMedia({ video: true });
                temp.getTracks().forEach(t => t.stop());
            } catch {
                alert("⚠ Không thể truy cập camera!");
                return;
            }

            const devices = await navigator.mediaDevices.enumerateDevices();
            const cameras = devices.filter(d => d.kind === "videoinput");

            const select = document.getElementById("cameraSelect");
            select.innerHTML = "";

            cameras.forEach((cam, index) => {
                const option = document.createElement("option");
                option.value = cam.deviceId;
                option.text = cam.label || "Camera " + (index + 1);
                select.appendChild(option);
            });
        }

        window.addEventListener("load", loadCameras);
        // ================= START CAMERA =================
        document.getElementById("btnStartCam")
        .addEventListener("click", async function () {

            const deviceId = document.getElementById("cameraSelect").value;
            if (!deviceId) return alert("Chọn camera");

            stopAllCamera();

            const stream = await navigator.mediaDevices.getUserMedia({
                video: { deviceId: { exact: deviceId } }
            });

            currentStream = stream;
            document.getElementById("video").srcObject = stream;

            // bắt đầu đếm thời gian khi bật cam
            examStartTime = Date.now();
            hasDetectedFace = false;
            lastViolationTime = 0;

            startFaceAI(document.getElementById("video"));
        });

        function stopAllCamera() {

            if (currentStream)
                currentStream.getTracks().forEach(t => t.stop());

            if (aiCamera) aiCamera.stop();
            if (faceDetector) faceDetector.close();

            currentStream = null;
            aiCamera = null;
            faceDetector = null;
            faceAIStarted = false;
        }

        // ================= FACE AI =================
        function startFaceAI(videoElement) {

            if (faceAIStarted) return;
            faceAIStarted = true;

            faceDetector = new window.FaceDetection({
                locateFile: file =>
                    `https://cdn.jsdelivr.net/npm/@@mediapipe/face_detection/${file}`
            });

            faceDetector.setOptions({
                model: "short",
                minDetectionConfidence: 0.6
            });

            faceDetector.onResults(results => {

                const faceCount = results.detections?.length ?? 0;

                if (faceCount > 0)
                    hasDetectedFace = true;

                // ===== NO FACE =====
                if (faceCount === 0) {
                    if (++noFaceCount >= 15) // ~3 giây
                        triggerRisk("Không thấy mặt", 20);
                } else noFaceCount = 0;

                // ===== MULTI FACE =====
                if (faceCount > 1) {
                    if (++multiFaceCount >= 10)
                        triggerRisk("Nhiều người xuất hiện", 30);
                } else multiFaceCount = 0;

                // ===== LOOK AWAY =====
                if (faceCount === 1) {
                    const box = results.detections[0].boundingBox;
                    const center = box.xCenter;

                    if (center < 0.3 || center > 0.7) {
                        if (++lookAwayCount >= 20)
                            triggerRisk("Quay mặt khỏi màn hình lâu", 15);
                    } else lookAwayCount = 0;
                }
            });

            aiCamera = new window.Camera(videoElement, {
                onFrame: async () => {
                    if (faceDetector)
                        await faceDetector.send({ image: videoElement });
                },
                width: 320,
                height: 240
            });

            aiCamera.start();
        }

        // ================= CHỤP ẢNH =================
        function captureImage() {

            const video = document.getElementById("video");
            const canvas = document.getElementById("canvas");
            const ctx = canvas.getContext("2d");

            canvas.width = 320;
            canvas.height = 240;
            ctx.drawImage(video, 0, 0, 320, 240);

            return canvas.toDataURL("image/jpeg", 0.6);
        }

        // ================= GỬI VI PHẠM =================
        async function triggerRisk(message, point) {

            const now = Date.now();

            // 🚫 1. Grace period
            if (now - examStartTime < GRACE_PERIOD)
                return;

            // 🚫 2. Chưa detect mặt lần nào
            if (!hasDetectedFace)
                return;

            // 🚫 3. Cooldown chống spam
            if (now - lastViolationTime < VIOLATION_COOLDOWN)
                return;

            lastViolationTime = now;

            try {

                const response = await fetch('/Student/LqvLamBai/ReportViolation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken':
                            document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        BaiLamId: baiLamId,
                        LoaiViPham: message,
                        DiemRisk: point,
                        DuongDanAnh: captureImage()
                    })
                });

                if (!response.ok) return;

                const result = await response.json();

                console.log("Risk:", result.tongRisk);

                if (result.biKhoa) {
                    alert("🚫 Bạn đã bị khóa bài do vi phạm.");
                    window.location.href =
                        '/Student/LqvLamBai/Result/' + baiLamId;
                }

            } catch (err) {
                console.error(err);
            }

            noFaceCount = 0;
            multiFaceCount = 0;
            lookAwayCount = 0;
        }
                // ================= TIMER =================

        let timeLeft = @ViewBag.ThoiGianConLai;
        const timerElement = document.getElementById("timer");

        function updateTimer() {

            if (timeLeft <= 0) {
                window.location.href =
                    '/Student/LqvLamBai/AutoSubmit?baiLamId=' + baiLamId;
                return;
            }

            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;

            timerElement.innerText =
                String(minutes).padStart(2, '0') + ":" +
                String(seconds).padStart(2, '0');

            timeLeft--;
        }

        setInterval(updateTimer, 1000);
        updateTimer();
        // ================= TAB SWITCH =================
        document.addEventListener("visibilitychange", function () {
            if (document.hidden)
                triggerRisk("Chuyển tab khi đang thi", 25);
        });
                // =========================
        // ĐÁNH DẤU CÂU ĐÃ TRẢ LỜI
        // =========================
                function markAnswered(cauHoiId) {
            const navItem = document.getElementById("nav-q-" + cauHoiId);
            if (navItem) navItem.classList.add("answered");
        }
        


        // =========================
        // CONFIRM NỘP BÀI
        // =========================
        function confirmSubmit() {

            if (confirm("Bạn chắc chắn muốn nộp bài?")) {
                document.getElementById("examForm").submit();
            }
        }

   
        // ================= CAMERA OFF =================
        setInterval(() => {

            if (!currentStream) return;

            const tracks = currentStream.getVideoTracks();
            if (tracks.length > 0 && tracks[0].readyState === "ended") {
                triggerRisk("Tắt camera khi đang thi", 60);
            }

        }, 2000);

    </script>
}