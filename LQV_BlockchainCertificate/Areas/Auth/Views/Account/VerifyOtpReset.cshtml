@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Xác minh OTP để đặt lại mật khẩu";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primary fw-bold">Xác minh mã OTP</h3>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger text-center">@TempData["Error"]</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success text-center">@TempData["Success"]</div>
                    }

                    <form asp-action="VerifyOtpReset" method="post">
                        <input type="hidden" name="email" value="@ViewBag.Email" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nhập mã OTP được gửi đến email của bạn</label>
                            <input type="text" name="otp" class="form-control rounded-3 text-center fs-5" maxlength="6" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold">
                            Xác minh
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="ForgotPassword" class="text-decoration-none fw-semibold">← Gửi lại mã OTP</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
