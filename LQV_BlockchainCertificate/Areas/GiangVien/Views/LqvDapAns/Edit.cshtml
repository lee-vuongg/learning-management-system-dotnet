@model LQV_BlockchainCertificate.Models.DBModel.LqvDapAn
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sửa đáp án";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<h3>✏️ Sửa đáp án</h3>
<hr />

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="LqvDapAnId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label class="form-label">Câu hỏi</label>
        <select asp-for="LqvCauHoiId"
                class="form-control"
                asp-items="ViewBag.LqvCauHoiId">
        </select>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Nội dung đáp án</label>
        <input asp-for="LqvNoiDung" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="LqvDung" class="form-check-input" type="checkbox" />
        <label class="form-check-label">
            Đáp án đúng
        </label>
    </div>

    <button type="submit" class="btn btn-success">💾 Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">⬅ Quay lại</a>
</form>
