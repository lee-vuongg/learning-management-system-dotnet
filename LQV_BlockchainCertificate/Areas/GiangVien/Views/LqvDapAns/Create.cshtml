@model LQV_BlockchainCertificate.Models.DBModel.LqvDapAn
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Thêm đáp án";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<h3>➕ Thêm đáp án</h3>
<hr />

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Câu hỏi -->
    <div class="form-group mb-3">
        <label class="form-label">Câu hỏi</label>
        <select asp-for="LqvCauHoiId"
                class="form-control"
                asp-items="ViewBag.LqvCauHoiId">
        </select>
    </div>

    <!-- Nội dung đáp án -->
    <div class="form-group mb-3">
        <label class="form-label">Nội dung đáp án</label>
        <input asp-for="LqvNoiDung" class="form-control" />
        <span asp-validation-for="LqvNoiDung" class="text-danger"></span>
    </div>

    <!-- Đúng / Sai -->
    <div class="form-check mb-3">
        <input asp-for="LqvDung" class="form-check-input" type="checkbox" />
        <label class="form-check-label">
            Đây là đáp án đúng
        </label>
    </div>

    <button type="submit" class="btn btn-primary">💾 Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">⬅ Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
