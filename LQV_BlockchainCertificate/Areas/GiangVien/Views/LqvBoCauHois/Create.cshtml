@model LQV_BlockchainCertificate.Models.DBModel.LqvBoCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thêm bộ câu hỏi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="text-center mb-4">
                    <div class="h1 text-primary"><i class="fas fa-folder-plus"></i></div>
                    <h4 class="fw-bold">Thêm Bộ câu hỏi</h4>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="LqvTenBo" class="form-label fw-bold small">Tên bộ câu hỏi</label>
                        <input asp-for="LqvTenBo" class="form-control rounded-3 py-2" />
                        <span asp-validation-for="LqvTenBo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LqvMoTa" class="form-label fw-bold small">Mô tả</label>
                        <textarea asp-for="LqvMoTa" class="form-control rounded-3" rows="3"></textarea>
                    </div>

                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            💾 Lưu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>