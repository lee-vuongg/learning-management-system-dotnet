@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Danh sách câu hỏi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold mb-1">📄 @ViewBag.TenBo</h4>
            <p class="text-muted small mb-0">Danh sách câu hỏi của bộ</p>
        </div>

        <a asp-controller="LqvCauHois"
           asp-action="Create"
           asp-route-boId="@ViewBag.BoId"
           class="btn btn-primary rounded-pill">
            <i class="fas fa-plus me-1"></i> Thêm câu hỏi
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:5%">#</th>
                        <th>Nội dung câu hỏi</th>
                        <th style="width:15%" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                Chưa có câu hỏi nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var q in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@q.LqvNoiDung</td>
                                <td class="text-center">
                                    <a asp-controller="LqvCauHois"
                                       asp-action="Edit"
                                       asp-route-id="@q.LqvCauHoiId"
                                       class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-controller="LqvCauHois"
                                          asp-action="Delete"
                                          asp-route-id="@q.LqvCauHoiId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Xóa câu hỏi này và toàn bộ đáp án?')">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>

                                    <a asp-controller="LqvDapAns"
                                       asp-action="ByCauHoi"
                                       asp-route-cauHoiId="@q.LqvCauHoiId"
                                       class="btn btn-sm btn-success"
                                       title="Quản lý đáp án">
                                        <i class="fas fa-list"></i>
                                    </a>

                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-light rounded-pill">
            ← Quay lại bộ câu hỏi
        </a>
    </div>
</div>
