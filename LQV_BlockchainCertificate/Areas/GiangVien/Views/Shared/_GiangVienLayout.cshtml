@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IHttpContextAccessor HttpContextAccessor
@{
    var user = HttpContextAccessor.HttpContext?.User;
    var fullName = user?.FindFirstValue("FullName") ?? "Giảng viên";
    var userAvatarUrl = user?.FindFirstValue("AvatarUrl") ?? "/img/default-avatar.png";
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Study4 Instructor</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --s4-bg: #F7F9FC;
            --s4-sidebar: #FFFFFF;
            --s4-primary: #0066FF;
            --s4-text: #1A202C;
            --s4-muted: #718096;
            --s4-border: #EDF2F7;
            --sidebar-width: 280px;
            --sidebar-collapsed-width: 80px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--s4-bg);
            color: var(--s4-text);
            overflow-x: hidden;
        }

        /* Sidebar Base */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--s4-sidebar);
            border-right: 1px solid var(--s4-border);
            position: fixed;
            height: 100vh;
            transition: var(--transition);
            z-index: 1050;
            overflow-y: auto;
            overflow-x: hidden;
        }

        body.sidebar-toggled .sidebar {
            width: var(--sidebar-collapsed-width);
        }

        .brand-box {
            padding: 2rem 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 1px solid var(--s4-border);
            height: 100px;
            transition: var(--transition);
        }

            .brand-box img {
                max-height: 150px;
                width: auto;
                transition: var(--transition);
            }

        body.sidebar-toggled .brand-box img {
            max-height: 35px;
        }

        .nav-group-label {
            padding: 1.5rem 1.5rem 0.5rem;
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--s4-muted);
            text-transform: uppercase;
            white-space: nowrap;
            transition: var(--transition);
        }

        body.sidebar-toggled .nav-group-label {
            opacity: 0;
            padding: 0.5rem;
        }

        .nav-link-s4 {
            display: flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            color: #4A5568;
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            border-left: 4px solid transparent;
            white-space: nowrap;
        }

            .nav-link-s4 i {
                min-width: 25px;
                margin-right: 12px;
                font-size: 1.1rem;
                text-align: center;
                transition: var(--transition);
            }

        body.sidebar-toggled .nav-link-s4 {
            padding: 1rem;
            justify-content: center;
        }

            body.sidebar-toggled .nav-link-s4 i {
                margin-right: 0;
                font-size: 1.3rem;
            }

            body.sidebar-toggled .nav-link-s4 span {
                display: none;
            }

        .nav-link-s4:hover {
            background: #F8FAFC;
            color: var(--s4-primary);
        }

        .nav-link-s4.active {
            color: var(--s4-primary);
            background: #EBF4FF;
            border-left-color: var(--s4-primary);
            font-weight: 600;
        }

        /* Main Content */
        .main-container {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        body.sidebar-toggled .main-container {
            margin-left: var(--sidebar-collapsed-width);
        }

        .top-nav {
            padding: 0.75rem 2rem;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--s4-border);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        /* Search Box Styling */
        .search-box-container .input-group {
            background: #f0f2f5;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid transparent;
            transition: all 0.2s;
            width: 320px;
        }

            .search-box-container .input-group:focus-within {
                background: white;
                border-color: var(--s4-primary);
                box-shadow: 0 0 0 4px rgba(0, 102, 255, 0.05);
                width: 400px;
            }

        #sidebarToggle {
            background: #f0f2f5;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            color: var(--s4-text);
            cursor: pointer;
            transition: 0.2s;
        }

            #sidebarToggle:hover {
                background: var(--s4-primary);
                color: white;
            }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            object-fit: cover;
        }

        .content-padding {
            padding: 2rem;
            flex-grow: 1;
        }

        .s4-footer {
            padding: 1.5rem;
            text-align: center;
            color: var(--s4-muted);
            font-size: 0.85rem;
        }

        @@media (max-width: 768px) {
            .sidebar {
                margin-left: -280px;
            }

            body.sidebar-toggled .sidebar {
                margin-left: 0;
                width: 280px;
            }

            .main-container {
                margin-left: 0 !important;
            }

            .search-box-container {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <aside class="sidebar" id="sidebar">
        <div class="brand-box">
            <img src="~/img/logo.png" alt="Study4" id="mainLogo" />
        </div>

        <nav class="mt-3">
            <a asp-area="GiangVien" asp-controller="Dashboard" asp-action="Index"
               class="nav-link-s4 @(currentController=="Dashboard"?"active":"")">
                <i class="fas fa-th-large"></i> <span>Tổng quan</span>
            </a>

            <div class="nav-group-label">Học thuật</div>

            <a asp-area="GiangVien" asp-controller="LqvLopHocs" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvLopHocs"?"active":"")">
                <i class="fas fa-layer-group"></i> <span>Lớp học của tôi</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvBoCauHois" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvBoCauHois"?"active":"")">
                <i class="fas fa-database"></i> <span>Ngân hàng câu hỏi</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvDeThis" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvDeThis"?"active":"")">
                <i class="fas fa-file-alt"></i> <span>Quản lý đề thi</span>
            </a>
            <a asp-area="GiangVien" asp-controller="LqvLichThis" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvLichThis"?"active":"")">
                <i class="fas fa-file-alt"></i> <span>Quản lý lịch thi</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvTienDoHocTaps" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvTienDoHocTaps"?"active":"")">
                <i class="fas fa-chart-line"></i> <span>Tiến độ học tập</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvDiemDanhGps" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvDiemDanhGps"?"active":"")">
                <i class="fas fa-user-check"></i> <span>Danh sách điểm danh</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvBuoiHocs" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvBuoiHocs"?"active":"")">
                <i class="fas fa-calendar-alt"></i> <span>Buổi học</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvKhoaHocs" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvKhoaHocs"?"active":"")">
                <i class="fas fa-book"></i> <span>Khóa học</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvBaiTaps" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvBaiTaps"?"active":"")">
                <i class="fas fa-tasks"></i> <span>Bài Tập</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvNopBaiTaps" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvNopBaiTaps"?"active":"")">
                <i class="fas fa-upload"></i> <span>Nộp Bài Tập</span>
            </a>

            <a asp-area="GiangVien" asp-controller="LqvBaiLams" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvBaiLams"?"active":"")">
                <i class="fas fa-user-edit"></i> <span>Bài thi sinh viên</span>
            </a>

            <div class="nav-group-label">Đánh giá</div>

            <a asp-area="GiangVien" asp-controller="LqvYeuCauCapChungChis" asp-action="Index"
               class="nav-link-s4 @(currentController=="LqvYeuCauCapChungChis"?"active":"")">
                <i class="fas fa-certificate"></i> <span>Đề xuất chứng chỉ</span>
            </a>
            
        </nav>
    </aside>

    <div class="main-container">
        <header class="top-nav d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="search-box-container d-none d-lg-block ms-2">
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-transparent text-muted ms-1">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="globalSearchInput" class="form-control border-0 bg-transparent shadow-none"
                               placeholder="Tìm nhanh (Tên lớp, Ngày, Trạng thái...)" style="font-size: 0.85rem; height: 40px;">
                    </div>
                </div>

                <div class="page-title d-none d-xl-block ms-2">
                    <h5 class="fw-bold mb-0 text-dark">@ViewData["Title"]</h5>
                </div>
            </div>

            <div class="dropdown">
                <div class="d-flex align-items-center gap-3" style="cursor:pointer" data-bs-toggle="dropdown">
                    <div class="text-end d-none d-sm-block">
                        <div class="fw-bold small">@fullName</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Instructor</div>
                    </div>
                    <img src="@userAvatarUrl" class="user-avatar" alt="User" />
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3">
                    <li><a class="dropdown-item py-2" href="#"><i class="fas fa-user-circle me-2"></i> Hồ sơ</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item py-2 text-danger" asp-area="Auth" asp-controller="Account" asp-action="Logout">
                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                        </a>
                    </li>
                </ul>
            </div>
        </header>

        <main class="content-padding">
            @RenderBody()
        </main>

        <footer class="s4-footer border-top mx-4">
            &copy; 2026 <strong>Study4 BlockCert</strong>. Instructor Management System.
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. Quản lý Sidebar
            if (localStorage.getItem('sidebar-state') === 'collapsed') {
                $('body').addClass('sidebar-toggled');
            }

            $('#sidebarToggle').click(function () {
                $('body').toggleClass('sidebar-toggled');
                localStorage.setItem('sidebar-state', $('body').hasClass('sidebar-toggled') ? 'collapsed' : 'expanded');
            });

            // 2. TÌM KIẾM TOÀN CỤC (GLOBAL SEARCH)
            $("#globalSearchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase().trim();

                // Tìm trong các hàng của Table
                $("table tbody tr").each(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });

                // Tìm trong các Card/Accordion (Trang Buổi học)
                $(".accordion-item, .session-container").each(function() {
                    var isMatch = $(this).text().toLowerCase().indexOf(value) > -1;
                    $(this).toggle(isMatch);

                    // Nếu khớp từ khóa, tự động mở Accordion ra để thấy nội dung bên trong
                    if (isMatch && value !== "") {
                        $(this).find(".accordion-collapse").addClass("show");
                    }
                });
            });

            // Phím tắt Ctrl + F hoặc / để tập trung vào ô tìm kiếm
            $(window).keydown(function(e) {
                if ((e.ctrlKey || e.metaKey) && e.keyCode === 70) { // Ctrl + F
                    e.preventDefault();
                    $("#globalSearchInput").focus();
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>