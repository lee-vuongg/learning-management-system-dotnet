@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvLichThi>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Danh sách lịch thi";
    var now = DateTime.Now;
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    :root {
        --s4-primary: #35509a;
        --s4-primary-light: #eef2ff;
        --s4-bg: #f8fafc;
        --s4-border: #e2e8f0;
        --s4-text-main: #1e293b;
        --s4-text-sub: #64748b;
        --radius-md: 12px;
        --radius-sm: 8px;
    }

    body {
        background-color: var(--s4-bg);
        font-family: 'Inter', sans-serif;
        color: var(--s4-text-main);
    }

    .page-container {
        padding: 2rem 0;
    }

    .page-title {
        font-weight: 700;
        color: var(--s4-primary);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Table Container */
    .s4-card {
        background: white;
        border-radius: var(--radius-md);
        border: 1px solid var(--s4-border);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .table thead {
            background-color: #f1f5f9;
        }

            .table thead th {
                border: none;
                color: var(--s4-text-sub);
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 1rem 1.5rem;
                font-weight: 600;
            }

        .table tbody tr {
            border-bottom: 1px solid var(--s4-border);
            transition: background 0.2s;
        }

            .table tbody tr:last-child {
                border-bottom: none;
            }

            .table tbody tr:hover {
                background-color: #f8fafc;
            }

        .table td {
            padding: 1.2rem 1.5rem;
            border: none;
            font-size: 0.9rem;
        }

    /* Exam Info Styling */
    .exam-info .exam-name {
        display: block;
        font-weight: 600;
        color: var(--s4-primary);
        margin-bottom: 4px;
    }

    .exam-info .class-tag {
        font-size: 0.8rem;
        color: var(--s4-text-sub);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .time-cell {
        color: #475569;
        font-weight: 500;
    }

        .time-cell i {
            color: var(--s4-text-sub);
            width: 16px;
        }

    /* Badges */
    .s4-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .bg-upcoming {
        background: #fef3c7;
        color: #92400e;
    }

    .bg-active {
        background: #dcfce7;
        color: #166534;
    }

    .bg-ended {
        background: #f1f5f9;
        color: #475569;
    }

    /* Action Buttons */
    .action-group {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .btn-s4 {
        border-radius: var(--radius-sm);
        padding: 6px 14px;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

    .btn-details {
        background: #e0e7ff;
        color: #4338ca;
    }

        .btn-details:hover {
            background: #c7d2fe;
        }

    .btn-monitor {
        background: #fff7ed;
        color: #9a3412;
    }

        .btn-monitor:hover {
            background: #ffedd5;
        }

    .btn-start {
        background: var(--s4-primary);
        color: white;
    }

        .btn-start:hover {
            background: #2a407a;
            color: white;
        }

    .btn-end {
        background: #ef4444;
        color: white;
    }

        .btn-end:hover {
            background: #dc2626;
            color: white;
        }
</style>

<div class="container page-container">
    <h2 class="page-title">
        <i class="fas fa-calendar-check"></i>
        Danh sách lịch thi
    </h2>

    <div class="s4-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Thông tin cuộc thi</th>
                    <th>Thời gian bắt đầu</th>
                    <th>Thời gian kết thúc</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string trangThai;
                    string badgeClass;

                    if (now < item.LqvBatDau)
                    {
                        trangThai = "Sắp thi";
                        badgeClass = "bg-upcoming";
                    }
                    else if (now >= item.LqvBatDau && now <= item.LqvKetThuc)
                    {
                        trangThai = "Đang thi";
                        badgeClass = "bg-active";
                    }
                    else
                    {
                        trangThai = "Đã kết thúc";
                        badgeClass = "bg-ended";
                    }

                    <tr>
                        <td class="exam-info">
                            <span class="exam-name">@item.LqvDeThi?.LqvTenDeThi</span>
                            <span class="class-tag">
                                <i class="fas fa-chalkboard-teacher"></i>
                                @item.LqvLopHoc?.LqvTenLop
                            </span>
                        </td>
                        <td class="time-cell">
                            <i class="far fa-calendar-plus me-1"></i>
                            @item.LqvBatDau.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="time-cell">
                            <i class="far fa-calendar-minus me-1"></i>
                            @item.LqvKetThuc.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <span class="s4-badge @badgeClass">
                                <i class="fas fa-circle-info me-1" style="font-size: 0.6rem;"></i>
                                @trangThai
                            </span>
                        </td>
                        <td>
                            <div class="action-group">
                                <a asp-action="Details" asp-route-id="@item.LqvLichThiId" class="btn-s4 btn-details">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>

                                <a asp-area="GiangVien" asp-controller="Proctor" asp-action="Monitor" asp-route-lichThiId="@item.LqvLichThiId" class="btn-s4 btn-monitor">
                                    <i class="fas fa-video"></i> Giám sát
                                </a>

                                @if (trangThai == "Sắp thi")
                                {
                                    <form asp-action="BatDauThi" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.LqvLichThiId" />
                                        <button type="submit" class="btn-s4 btn-start">
                                            <i class="fas fa-play"></i> Bắt đầu
                                        </button>
                                    </form>
                                }
                                else if (trangThai == "Đang thi")
                                {
                                    <form asp-action="KetThucThi" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.LqvLichThiId" />
                                        <button type="submit" class="btn-s4 btn-end">
                                            <i class="fas fa-stop"></i> Kết thúc
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>