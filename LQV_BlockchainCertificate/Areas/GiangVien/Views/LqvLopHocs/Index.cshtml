@model List<LQV_BlockchainCertificate.Models.DBModel.LqvLopHoc>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Lớp học của tôi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<style>


    <style >
    .study-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -1px rgba(0,0,0,.06);
        margin: 2rem 0;
        overflow: hidden;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .study-card-header {
        padding: 1.5rem;
        border-bottom: 1px solid #f1f5f9;
    }

        .study-card-header h5 {
            margin: 0;
            color: #1e293b;
            font-weight: 700;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .study-card-header i {
            color: #4f46e5;
        }

    .study-table thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .study-table tbody td {
        padding: 1.25rem 1.5rem;
        vertical-align: middle;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
    }

    .study-table tbody tr:hover {
        background-color: #f8fafc;
    }

    .badge-s4 {
        background-color: #ecfdf5;
        color: #059669;
        padding: 6px 12px;
        border-radius: 9999px;
        font-weight: 600;
        font-size: 0.75rem;
        border: 1px solid #d1fae5;
    }

    .btn-action-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn-s4 {
        border-radius: 10px;
        padding: 7px 14px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #e2e8f0;
        text-decoration: none;
        transition: .2s;
    }

    .btn-primary-s4 {
        color: #4f46e5;
    }

        .btn-primary-s4:hover {
            background: #4f46e5;
            color: #fff !important;
        }

    .btn-info-s4 {
        color: #0ea5e9;
    }

        .btn-info-s4:hover {
            background: #0ea5e9;
            color: #fff !important;
        }

    .btn-success-s4 {
        color: #059669;
    }

        .btn-success-s4:hover {
            background: #059669;
            color: #fff !important;
        }

    .empty-row {
        text-align: center;
        padding: 3rem !important;
        color: #94a3b8;
    }
</style>
</style>

<div class="study-card">
    <div class="study-card-header">
        <h5><i class="fas fa-chalkboard-teacher"></i> Lớp học được phân công</h5>
    </div>

    <div class="table-responsive">
        <table class="table study-table">
            <thead>
                <tr>
                    <th>Tên lớp</th>
                    <th>Khóa học</th>
                    <th class="text-center">Sĩ số</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var lop in Model)
                    {
                        <tr style="cursor:pointer"
                            onclick="location.href='@Url.Action(
                                "Index",
                                "LqvClassroom",
                                new { area = "GiangVien", lopHocId = lop.LqvLopHocId }
                            )'">

                            <!-- TÊN LỚP -->
                            <td>
                                <strong class="text-primary">
                                    @lop.LqvTenLop
                                </strong>
                            </td>

                            <!-- KHÓA HỌC -->
                            <td>
                                <i class="fas fa-book-open me-1 text-muted"></i>
                                @(lop.LqvKhoaHoc?.LqvTenKhoaHoc ?? "Chưa xác định")
                            </td>

                            <!-- SĨ SỐ -->
                            <td class="text-center">
                                <span class="badge-s4">
                                    <i class="fas fa-user-graduate me-1"></i>
                                    @(lop.LqvDangKyLopHocs?.Count ?? 0) SV
                                </span>
                            </td>

                            <!-- ACTION -->
                            <td onclick="event.stopPropagation();">
                                <div class="btn-action-group">

                                    <!-- VÀO LỚP (CHUẨN GOOGLE CLASSROOM) -->
                                    <a asp-area="GiangVien"
                                       asp-controller="LqvClassroom"
                                       asp-action="Index"
                                       asp-route-lopHocId="@lop.LqvLopHocId"
                                       class="btn-s4 btn-primary-s4">
                                        <i class="fas fa-door-open"></i> Vào lớp
                                    </a>

                                    <!-- SINH VIÊN -->
                                    <a asp-action="SinhVien"
                                       asp-route-id="@lop.LqvLopHocId"
                                       class="btn-s4 btn-info-s4">
                                        <i class="fas fa-users"></i> Sinh viên
                                    </a>

                                    <!-- EXPORT -->
                                    <a asp-action="ExportSinhVien"
                                       asp-route-lopHocId="@lop.LqvLopHocId"
                                       class="btn-s4 btn-success-s4">
                                        <i class="fas fa-file-excel"></i> Export
                                    </a>

                                    <!-- IMPORT -->
                                    <form asp-action="ImportSinhVien"
                                          asp-route-lopHocId="@lop.LqvLopHocId"
                                          method="post"
                                          enctype="multipart/form-data"
                                          style="display:inline-flex; align-items:center; gap:4px;">

                                        <label class="btn-s4 btn-success-s4" style="cursor:pointer;">
                                            <i class="fas fa-upload"></i> Import
                                            <input type="file"
                                                   name="file"
                                                   accept=".xlsx"
                                                   hidden
                                                   onchange="this.form.submit()" />
                                        </label>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-row">
                            <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
                            Chưa có lớp học nào được phân công
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

