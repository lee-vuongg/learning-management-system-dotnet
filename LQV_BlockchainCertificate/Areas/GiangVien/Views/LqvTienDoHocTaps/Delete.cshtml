@model LQV_BlockchainCertificate.Models.DBModel.LqvTienDoHocTap
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-5 text-center">
        <div class="bg-soft-danger d-inline-block p-4 rounded-circle mb-4">
            <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
        </div>
        <h3 class="fw-800">Xác nhận xóa tiến độ?</h3>
        <p class="text-muted px-4">Hành động này sẽ xóa dữ liệu tiến độ của sinh viên <strong>@Model.LqvSinhVien?.LqvHoTen</strong>. Bạn không thể hoàn tác sau khi thực hiện.</p>

        <div class="card bg-light border-0 rounded-4 p-3 mb-4">
            <div class="small text-muted text-uppercase fw-bold mb-1">Khóa học</div>
            <div class="fw-bold">@Model.LqvKhoaHoc?.LqvTenKhoaHoc</div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="LqvId" />
            <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow">Xóa vĩnh viễn</button>
            <div class="mt-3">
                <a asp-action="Index" class="text-muted fw-bold text-decoration-none small">Hủy và quay về danh sách</a>
            </div>
        </form>
    </div>
</div>