@model LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sửa câu hỏi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<h3>✏️ Sửa câu hỏi</h3>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="LqvCauHoiId" />
    <input type="hidden" asp-for="LqvBoCauHoiId" />

    <div class="mb-3">
        <label asp-for="LqvNoiDung"></label>
        <textarea asp-for="LqvNoiDung" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="LqvLoai"></label>
        <select asp-for="LqvLoai" class="form-select">
            <option value="TracNghiem">Trắc nghiệm</option>
            <option value="TuLuan">Tự luận</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="LqvDiem"></label>
        <input asp-for="LqvDiem" type="number" step="0.25" class="form-control" />
    </div>

    <button class="btn btn-primary">Lưu</button>
    <a asp-action="Index"
       asp-route-boId="@Model.LqvBoCauHoiId"
       class="btn btn-secondary">
        Quay lại
    </a>
</form>
