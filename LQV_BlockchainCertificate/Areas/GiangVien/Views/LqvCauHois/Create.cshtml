@model LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Thêm câu hỏi mới";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<style>
    :root {
        --s4-primary: #1976d2;
        --s4-primary-light: #e3f2fd;
        --s4-text-main: #2d3436;
        --s4-text-muted: #636e72;
        --s4-border: #edf2f7;
        --s4-bg: #f8f9fa;
    }

    .s4-wrapper {
        background-color: var(--s4-bg);
        min-height: 100vh;
        padding: 2.5rem 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .s4-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        background: #fff;
        overflow: hidden;
    }

    .s4-header {
        padding: 2rem 2rem 1.5rem;
        background: #fff;
        border-bottom: 1px solid var(--s4-border);
    }

    .s4-title {
        font-weight: 800;
        color: var(--s4-text-main);
        font-size: 1.4rem;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .s4-label {
        font-weight: 600;
        color: var(--s4-text-main);
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
    }

    /* Input styling */
    .s4-input, .s4-select, .s4-textarea {
        border: 2px solid var(--s4-border);
        border-radius: 12px;
        padding: 12px 16px;
        transition: all 0.25s ease;
        font-size: 0.95rem;
        background-color: #fff;
    }

        .s4-input:focus, .s4-select:focus, .s4-textarea:focus {
            border-color: var(--s4-primary);
            box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.1);
            outline: none;
        }

    /* Specialized sections */
    .s4-content-box {
        background: #fcfcfd;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px dashed #d1d9e0;
    }

    /* Buttons */
    .btn-save {
        background: var(--s4-primary);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 12px 30px;
        font-weight: 700;
        transition: all 0.3s ease;
    }

        .btn-save:hover {
            background: #1565c0;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(25, 118, 210, 0.25);
            color: #fff;
        }

    .btn-back {
        background: transparent;
        color: var(--s4-text-muted);
        border: 2px solid var(--s4-border);
        border-radius: 12px;
        padding: 12px 25px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-back:hover {
            background: var(--s4-border);
            color: var(--s4-text-main);
        }

    .input-group-text-s4 {
        background: var(--s4-primary-light);
        border: 2px solid var(--s4-border);
        border-right: none;
        border-radius: 12px 0 0 12px;
        color: var(--s4-primary);
        font-weight: 600;
    }

    .has-icon .s4-input {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }
</style>

<div class="s4-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="s4-card">
                    <div class="s4-header text-center">
                        <div class="mb-2">
                            <span class="badge rounded-pill" style="background: var(--s4-primary-light); color: var(--s4-primary); padding: 8px 16px;">
                                Ngân hàng câu hỏi
                            </span>
                        </div>
                        <h3 class="s4-title">Tạo Câu Hỏi Mới</h3>
                        <p class="text-muted small mt-2">Điền thông tin chi tiết để thêm câu hỏi vào hệ thống lưu trữ.</p>
                    </div>

                    <form asp-action="Create" method="post" class="p-4 p-md-5 pt-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small"></div>

                        <div class="row g-4">
                            <div class="col-12">
                                <label class="s4-label"><i class="fas fa-layer-group me-2 text-primary"></i>Chọn bộ câu hỏi</label>
                                <select asp-for="LqvBoCauHoiId"
                                        asp-items="ViewBag.BoCauHois"
                                        class="form-select s4-select">
                                    <option value="">-- Danh sách bộ câu hỏi --</option>
                                </select>
                                <span asp-validation-for="LqvBoCauHoiId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-12">
                                <div class="s4-content-box">
                                    <label class="s4-label"><i class="fas fa-edit me-2 text-primary"></i>Nội dung câu hỏi</label>
                                    <textarea asp-for="LqvNoiDung"
                                              class="form-control s4-textarea"
                                              rows="4"
                                              placeholder="Nhập nội dung câu hỏi tại đây..."></textarea>
                                    <span asp-validation-for="LqvNoiDung" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="s4-label">Phân loại</label>
                                <select asp-for="LqvLoai" class="form-select s4-select">
                                    <option value="TracNghiem">Trắc nghiệm</option>
                                    <option value="TuLuan">Tự luận</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="s4-label">Điểm số</label>
                                <div class="input-group has-icon">
                                    <span class="input-group-text input-group-text-s4"><i class="fas fa-star"></i></span>
                                    <input asp-for="LqvDiem"
                                           type="number"
                                           step="0.25"
                                           class="form-control s4-input"
                                           placeholder="Ví dụ: 0.25" />
                                </div>
                                <span asp-validation-for="LqvDiem" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn-back">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                            <button type="submit" class="btn-save shadow-sm">
                                <i class="fas fa-save me-2"></i>Lưu câu hỏi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}