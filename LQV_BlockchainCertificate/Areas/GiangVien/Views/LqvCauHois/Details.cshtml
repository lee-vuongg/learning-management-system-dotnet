@model LQV_BlockchainCertificate.Models.DBModel.LqvCauHoi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chi tiết câu hỏi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h3>📄 Chi tiết câu hỏi</h3>
<hr />

<table class="table table-bordered">
    <tr>
        <th width="150">Bộ câu hỏi</th>
        <td>@Model.LqvBoCauHoi.LqvTenBo</td>
    </tr>
    <tr>
        <th>Nội dung</th>
        <td>@Model.LqvNoiDung</td>
    </tr>
    <tr>
        <th>Loại</th>
        <td>@Model.LqvLoai</td>
    </tr>
    <tr>
        <th>Điểm</th>
        <td>@Model.LqvDiem</td>
    </tr>
</table>

<hr />

<h4>📌 Danh sách đáp án</h4>

<table class="table table-striped table-bordered" id="dapAnTable">
    <thead class="table-dark">
        <tr>
            <th>Nội dung đáp án</th>
            <th width="120">Đúng / Sai</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.LqvDapAns != null && Model.LqvDapAns.Any())
        {
            foreach (var da in Model.LqvDapAns)
            {
                <tr>
                    <td>@da.LqvNoiDung</td>
                    <td class="text-center">
                        @if (da.LqvDung)
                        {
                            <span class="badge bg-success">Đúng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sai</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted">
                    Chưa có đáp án
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h4>➕ Thêm đáp án</h4>

<div class="row g-2">
    <div class="col-md-6">
        <input type="text"
               id="noiDung"
               class="form-control"
               placeholder="Nhập nội dung đáp án" />
    </div>

    <div class="col-md-3">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="dung" />
            <label class="form-check-label">Đáp án đúng</label>
        </div>
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary w-100" onclick="themDapAn()">
            Thêm đáp án
        </button>
    </div>
</div>

<hr />

<a asp-action="Edit"
   asp-route-id="@Model.LqvCauHoiId"
   class="btn btn-warning">
    ✏️ Sửa câu hỏi
</a>

<a asp-action="Index" class="btn btn-secondary">
    ⬅ Quay lại
</a>

@section Scripts {
    <script>
        function themDapAn() {
            const noiDung = document.getElementById("noiDung").value;
            const dung = document.getElementById("dung").checked;

            if (noiDung.trim() === "") {
                alert("Vui lòng nhập nội dung đáp án");
                return;
            }

           fetch('/GiangVien/LqvDapAns/CreateAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body:
                    'cauHoiId=@Model.LqvCauHoiId' +
                    '&noiDung=' + encodeURIComponent(noiDung) +
                    '&dung=' + dung
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const tbody = document
                        .getElementById("dapAnTable")
                        .getElementsByTagName("tbody")[0];

                    const row = tbody.insertRow();
                    row.insertCell(0).innerText = data.noiDung;
                    row.insertCell(1).innerHTML =
                        data.dung
                            ? '<span class="badge bg-success">Đúng</span>'
                            : '<span class="badge bg-secondary">Sai</span>';

                    document.getElementById("noiDung").value = "";
                    document.getElementById("dung").checked = false;
                } else {
                    alert(data.message);
                }
            });
        }
    </script>
}
