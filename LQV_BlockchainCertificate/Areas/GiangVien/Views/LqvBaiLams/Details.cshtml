@model LQV_BlockchainCertificate.Models.DBModel.LqvBaiLam
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết bài làm";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh sách</a></li>
            <li class="breadcrumb-item active">Chi tiết bài làm</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-journal-text me-2"></i>Nội dung bài làm</h5>
                </div>
                <div class="card-body p-4">
                    @{
                        int i = 1;
                    }
                    @foreach (var ct in Model.LqvChiTietBaiLams)
                    {
                        <div class="question-item mb-4 p-4 border rounded-4 bg-white shadow-sm shadow-hover transition">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-secondary rounded-pill px-3">Câu @(i++)</span>
                                <span class="text-primary fw-bold">@ct.LqvDiem / @ct.LqvCauHoi.LqvDiem điểm</span>
                            </div>

                            <p class="fw-bold text-dark fs-5 mb-3">@ct.LqvCauHoi.LqvNoiDung</p>

                            @if (ct.LqvCauHoi.LqvLoai == "TracNghiem")
                            {
                                <div class="p-3 rounded-3 bg-light border-start border-primary border-4">
                                    <small class="text-muted d-block mb-1">Đáp án sinh viên chọn:</small>
                                    <strong class="text-dark">@ct.LqvDapAn?.LqvNoiDung</strong>
                                </div>
                            }
                            else
                            {
                                <div class="p-3 rounded-3 bg-light border-start border-warning border-4">
                                    <small class="text-muted d-block mb-1">Câu trả lời tự luận:</small>
                                    <div class="text-dark preserve-whitespace">@ct.LqvTraLoiTuLuan</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 20px;">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 mb-3 overflow-hidden">
                    <div class="position-absolute top-0 start-0 w-100 h-2 bg-primary"></div>
                    <h6 class="text-muted text-uppercase small fw-bold mt-2">Tổng điểm đạt được</h6>
                    <div class="display-3 fw-bold text-primary my-2">@Model.LqvDiem</div>
                    <div class="mb-3">
                        <span class="badge @(Model.LqvTrangThai == "DaCham" ? "bg-success" : "bg-warning") px-3 rounded-pill">
                            @(Model.LqvTrangThai == "DaCham" ? "Đã chấm điểm" : "Đang chờ chấm")
                        </span>
                    </div>
                    <hr class="my-4">
                    <div class="text-start mb-4">
                        <div class="mb-2 small"><i class="bi bi-person me-2 text-muted"></i><b>Sinh viên:</b> @Model.LqvNguoiDung.LqvHoTen</div>
                        <div class="mb-2 small"><i class="bi bi-book me-2 text-muted"></i><b>Lớp:</b> @Model.LqvLichThi.LqvLopHoc.LqvTenLop</div>
                        <div class="mb-2 small"><i class="bi bi-clock me-2 text-muted"></i><b>Nộp lúc:</b> @Model.LqvThoiGianNop?.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <a asp-action="ChamBai" asp-route-id="@Model.LqvBaiLamId" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chấm bài ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .preserve-whitespace {
        white-space: pre-wrap;
    }

    .shadow-hover:hover {
        box-shadow: 0 5px 15px rgba(0,0,0,0.08) !important;
    }

    .transition {
        transition: all 0.3s ease;
    }

    .bg-primary {
        background-color: #2c5891 !important;
    }

    .text-primary {
        color: #2c5891 !important;
    }

    </ol >