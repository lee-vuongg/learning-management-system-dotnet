@model LQV_BlockchainCertificate.Models.DBModel.LqvBaiLam
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chấm bài tự luận";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-light rounded-circle me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h3 class="fw-bold m-0">
            Chấm điểm bài làm:
            <span class="text-primary">@Model.LqvNguoiDung.LqvHoTen</span>
        </h3>
    </div>

    <form asp-action="ChamBai" method="post">
        <input type="hidden" name="baiLamId" value="@Model.LqvBaiLamId" />

        <div class="row">
            <!-- ===================== -->
            <!-- DANH SÁCH CÂU HỎI -->
            <!-- ===================== -->
            <div class="col-lg-9">
                @foreach (var ct in Model.LqvChiTietBaiLams)
                {
                    var dapAnMau = ct.LqvCauHoi.LqvDapAns
                    ?.FirstOrDefault(x => x.LqvDung);

                    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden
                        border-start border-4
                        @(ct.LqvCauHoi.LqvLoai == "TracNghiem" ? "border-success" : "border-primary")">

                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="badge @(ct.LqvCauHoi.LqvLoai == "TracNghiem" ? "bg-success" : "bg-primary") rounded-pill px-3">
                                    @(ct.LqvCauHoi.LqvLoai == "TracNghiem" ? "Trắc nghiệm" : "Tự luận")
                                </span>
                                <span class="text-muted small">
                                    Tối đa: @ct.LqvCauHoi.LqvDiem điểm
                                </span>
                            </div>

                            <!-- NỘI DUNG CÂU HỎI -->
                            <h5 class="fw-bold mb-3">
                                @ct.LqvCauHoi.LqvNoiDung
                            </h5>

                            <!-- ===================== -->
                            <!-- TRẮC NGHIỆM -->
                            <!-- ===================== -->
                            @if (ct.LqvCauHoi.LqvLoai == "TracNghiem")
                            {
                                <div class="bg-light p-3 rounded-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <i class="bi bi-check2-circle text-success me-2"></i>
                                        Sinh viên chọn:
                                        <strong>@ct.LqvDapAn?.LqvNoiDung</strong>
                                    </div>
                                    <div class="text-success fw-bold">
                                        + @(ct.LqvDiem ?? 0) điểm
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- ===================== -->
                                <!-- BÀI LÀM SINH VIÊN -->
                                <!-- ===================== -->
                                <div class="mb-3">
                                    <label class="text-muted small mb-2 text-uppercase fw-bold">
                                        ✍️ Bài làm sinh viên
                                    </label>
                                    <div class="p-3 rounded-3 bg-light border">
                                        @ct.LqvTraLoiTuLuan
                                    </div>
                                </div>

                                <!-- ===================== -->
                                <!-- ĐÁP ÁN MẪU / GỢI Ý -->
                                <!-- ===================== -->
                                <div class="mb-3">
                                    <label class="text-muted small mb-2 text-uppercase fw-bold text-success">
                                        📘 Đáp án mẫu / Gợi ý chấm
                                    </label>

                                    <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success">
                                        @if (dapAnMau != null)
                                        {
                                            <div class="text-dark">
                                                @dapAnMau.LqvNoiDung
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted fst-italic">
                                                (Chưa có đáp án mẫu cho câu hỏi này)
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- ===================== -->
                                <!-- NHẬP ĐIỂM -->
                                <!-- ===================== -->
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-primary">
                                            Nhập điểm chấm:
                                        </label>
                                        <div class="input-group">
                                            <input type="number"
                                                   step="0.1"
                                                   max="@ct.LqvCauHoi.LqvDiem"
                                                   min="0"
                                                   name="diemTuLuan[@ct.LqvId]"
                                                   value="@ct.LqvDiem"
                                                   class="form-control form-control-lg rounded-start-pill border-primary border-2 shadow-sm"
                                                   placeholder="0.0"
                                                   required />
                                            <span class="input-group-text rounded-end-pill bg-primary text-white border-primary border-2 px-3 fw-bold">
                                                / @ct.LqvCauHoi.LqvDiem
                                            </span>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mt-3 mt-md-0">
                                        <div class="alert alert-warning mb-0 p-2 small border-0 shadow-none">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Nhập số thập phân (VD: 8.5)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- ===================== -->
            <!-- SIDEBAR LƯU -->
            <!-- ===================== -->
            <div class="col-lg-3">
                <div class="sticky-top" style="top: 20px;">
                    <div class="card border-0 shadow-lg rounded-4 p-3 bg-primary text-white">
                        <p class="small opacity-75 text-center mb-3">
                            Sau khi nhập hết điểm tự luận, hãy nhấn nút dưới đây để hoàn tất.
                        </p>
                        <button type="submit"
                                class="btn btn-light btn-lg w-100 rounded-pill fw-bold text-primary shadow">
                            <i class="bi bi-save me-2"></i>
                            Lưu kết quả
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
