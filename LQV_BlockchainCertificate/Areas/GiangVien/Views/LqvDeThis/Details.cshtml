@model LQV_BlockchainCertificate.Models.DBModel.LqvDeThi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết đề thi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="p-4 bg-dark text-white d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary mb-2">ĐỀ THI HỆ THỐNG</span>
                        <h3 class="fw-bold mb-0">@Model.LqvTenDeThi</h3>
                    </div>
                    @if (Model.LqvDaDuyet)
                    {
                        <span class="badge rounded-pill bg-success px-3 py-2"><i class="fas fa-check me-1"></i> ĐÃ DUYỆT</span>
                    }
                </div>

                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-6">
                            <label class="small text-muted text-uppercase fw-bold d-block">Thời gian làm bài</label>
                            <span class="fs-5 fw-bold text-primary"><i class="far fa-clock me-1"></i> @Model.LqvThoiGianThi Phút</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted text-uppercase fw-bold d-block">Cấu trúc điểm</label>
                            <span class="fs-5 fw-bold text-dark"><i class="fas fa-star me-1"></i> @Model.LqvTongDiem Điểm</span>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 border-start border-4 border-primary">
                        <label class="small text-muted fw-bold d-block">Bộ câu hỏi sử dụng:</label>
                        <span class="fw-bold fs-6 text-dark">@Model.LqvBoCauHoi?.LqvTenBo</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-bold">Quay lại</a>

                        @if (!Model.LqvDaDuyet)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.LqvDeThiId" class="btn btn-warning rounded-3 px-4 fw-bold">Sửa đề</a>

                            <form asp-action="GuiDuyet" asp-route-id="@Model.LqvDeThiId" method="post" onsubmit="return confirm('Gửi đề thi này để admin duyệt?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold shadow-sm">
                                    <i class="fas fa-paper-plane me-2"></i>Gửi duyệt ngay
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>