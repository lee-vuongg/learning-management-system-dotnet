@model LQV_BlockchainCertificate.Models.DBModel.LqvDeThi
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var isEdit = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
    ViewData["Title"] = isEdit ? "Cập nhật đề thi" : "Tạo đề thi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<style>
    .form-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #eef2f6;
        padding: 2.5rem;
    }

    .form-label {
        font-weight: 700;
        color: #475569;
        font-size: 0.85rem;
        text-transform: uppercase;
        margin-bottom: 0.7rem;
        display: block;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 2px solid #f1f5f9;
        padding: 0.75rem 1rem;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: none;
            background: #fff;
        }

    .input-group-text {
        border-radius: 0 12px 12px 0;
        border: 2px solid #f1f5f9;
        border-left: none;
        background: #f8fafc;
    }

    .form-control-right-radius {
        border-radius: 12px 0 0 12px !important;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-bold"><i class="fas fa-arrow-left me-1"></i> DANH SÁCH ĐỀ THI</a>
                <h2 class="fw-800 mt-2">@(isEdit ? "✏️ Hiệu chỉnh đề thi" : "➕ Thiết lập đề thi mới")</h2>
            </div>

            <div class="form-card shadow-sm">
                <form asp-action="@(isEdit ? "Edit" : "Create")">
                    @if (isEdit)
                    {
                        <input type="hidden" asp-for="LqvDeThiId" />
                    }

                    <div class="mb-4">
                        <label asp-for="LqvTenDeThi" class="form-label">Tên đề thi hiển thị</label>
                        <input asp-for="LqvTenDeThi" class="form-control" placeholder="VD: Kiểm tra giữa kỳ Blockchain..." />
                        <span asp-validation-for="LqvTenDeThi" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="LqvBoCauHoiId" class="form-label">Chọn nguồn câu hỏi</label>
                        <select asp-for="LqvBoCauHoiId" class="form-select shadow-sm" asp-items="ViewBag.LqvBoCauHoiId">
                            <option value="">-- Lấy từ bộ câu hỏi --</option>
                        </select>
                        <span asp-validation-for="LqvBoCauHoiId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="LqvThoiGianThi" class="form-label">Thời gian làm bài</label>
                            <div class="input-group">
                                <input asp-for="LqvThoiGianThi" type="number" class="form-control form-control-right-radius" />
                                <span class="input-group-text small fw-bold">PHÚT</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="LqvTongDiem" class="form-label">Thang điểm tổng</label>
                            <input asp-for="LqvTongDiem" type="number" step="0.1" class="form-control" />
                        </div>
                    </div>

                    @if (isEdit)
                    {
                        <div class="bg-light p-3 rounded-3 mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="LqvDaDuyet">
                                <label class="form-check-label fw-bold" asp-for="LqvDaDuyet">Xác nhận duyệt đề thi này</label>
                            </div>
                            <div class="mt-2">
                                <label class="form-label small mb-1">Ngày duyệt (nếu có)</label>
                                <input asp-for="LqvNgayDuyet" type="datetime-local" class="form-control form-control-sm" />
                            </div>
                        </div>
                    }

                    <div class="pt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold px-5 shadow-sm">Lưu dữ liệu</button>
                        <a asp-action="Index" class="btn btn-light btn-lg rounded-3 fw-bold text-muted px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>