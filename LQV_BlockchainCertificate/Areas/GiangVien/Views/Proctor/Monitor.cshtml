@model LQV_BlockchainCertificate.Models.ViewModels.ProctorMonitorVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Giám sát thi";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    :root {
        --s4-primary: #35509a;
        --s4-danger: #ef4444;
        --s4-warning: #f59e0b;
        --s4-success: #10b981;
        --s4-bg: #f8fafc;
        --s4-card-bg: #ffffff;
        --s4-border: #e2e8f0;
        --radius-lg: 16px;
    }

    body {
        background-color: var(--s4-bg);
        font-family: 'Inter', sans-serif;
    }

    .page-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .student-card {
        background: var(--s4-card-bg);
        border-radius: var(--radius-lg);
        border: 1px solid var(--s4-border);
        overflow: hidden;
        transition: transform 0.2s ease;
        cursor: pointer;
        /* Tối ưu GPU */
        backface-visibility: hidden;
        transform: translateZ(0);
    }

        .student-card:hover {
            transform: translateY(-4px) translateZ(0);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

    .student-header {
        padding: 10px 15px;
        background: #fff;
        border-bottom: 1px solid var(--s4-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .student-id {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--s4-primary);
    }

    .risk-badge {
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .risk-low {
        background: #dcfce7;
        color: #166534;
    }

    .risk-medium {
        background: #fef9c3;
        color: #854d0e;
    }

    .risk-high {
        background: #fee2e2;
        color: #991b1b;
    }

    .video-wrapper {
        position: relative;
        aspect-ratio: 4/3;
        background: #0f172a;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .video-stream {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* Chống giật lag hình ảnh */
        image-rendering: optimizeSpeed;
    }

    .no-signal {
        color: #64748b;
        text-align: center;
        font-size: 0.8rem;
    }

    .warning-overlay {
        position: absolute;
        inset: 0;
        border: 4px solid var(--s4-danger);
        pointer-events: none;
        display: none;
        z-index: 5;
    }

    .locked-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        z-index: 10;
        text-align: center;
    }

    /* Log section */
    .log-container {
        background: white;
        border-radius: var(--radius-lg);
        padding: 15px;
        border: 1px solid var(--s4-border);
        margin-top: 20px;
    }

    #violationLog {
        max-height: 250px;
        overflow-y: auto;
        font-size: 0.85rem;
    }

    .log-entry {
        padding: 8px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        gap: 15px;
    }

    /* Modal */
    #historyModal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    #historyContent {
        background: white;
        width: 90%;
        max-width: 600px;
        border-radius: var(--radius-lg);
        padding: 20px;
    }
</style>

<div class="container-fluid px-4 py-3">
    <div class="page-header">
        <h5 class="fw-bold m-0"><i class="fas fa-video me-2 text-primary"></i>Giám sát Lớp học Realtime</h5>
        <div class="d-flex gap-2">
            <span id="liveCount" class="badge bg-success p-2">LIVE: 0</span>
        </div>
    </div>

    <div class="row" id="videoContainer">
        @foreach (var student in Model.Students)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                <div class="student-card shadow-sm" onclick="openHistory('@student.UserId')" id="card_@student.UserId" data-userid="@student.UserId">
                    <div class="student-header">
                        <span class="student-id">@student.UserId</span>
                        <div class="d-flex align-items-center gap-1">
                            <span id="risk_@student.UserId" class="risk-badge @(student.TongRisk < 30 ? "risk-low" : student.TongRisk < 70 ? "risk-medium" : "risk-high")">
                                R: @student.TongRisk
                            </span>
                            <span id="status_@student.UserId" class="badge bg-secondary" style="font-size: 0.6rem;">OFFLINE</span>
                        </div>
                    </div>

                    <div class="video-wrapper">
                        <div class="no-signal" id="nosignal_@student.UserId">
                            <i class="fas fa-circle-notch fa-spin mb-2"></i><br>Chờ luồng...
                        </div>
                        <img id="video_@student.UserId" class="video-stream" decoding="async" style="display:none;" />
                        <div id="warning_@student.UserId" class="warning-overlay"></div>
                        <div id="locked_@student.UserId" class="locked-overlay" style="display:none;">
                            <span>🔒 ĐÃ KHÓA</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="log-container">
        <div class="d-flex justify-content-between mb-2">
            <h6 class="fw-bold m-0">Nhật ký vi phạm</h6>
            <button onclick="clearLog()" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">Xóa</button>
        </div>
        <div id="violationLog"></div>
    </div>
</div>

<div id="historyModal" onclick="if(event.target == this) closeHistory()">
    <div id="historyContent">
        <h6 class="fw-bold border-bottom pb-2" id="historyTitle"></h6>
        <div id="historyList" style="max-height: 400px; overflow-y: auto;"></div>
        <div class="text-end mt-3">
            <button onclick="closeHistory()" class="btn btn-sm btn-secondary">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const examRoom = "exam_@Model.LichThiId";
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/proctorHub")
            .withHubProtocol(new signalR.JsonHubProtocol()) // Đảm bảo dùng JSON nhanh
            .withAutomaticReconnect([0, 2000, 5000, 10000])
            .build();

        let violationHistory = {};
        let lastFrameTime = {};
        const OFFLINE_TIMEOUT = 10000;

        connection.start().then(() => {
            connection.invoke("JoinExamRoom", examRoom);
            renderLoop(); // Bắt đầu vòng lặp kiểm tra trạng thái
        });

        // TỐI ƯU FPS: Xử lý frame bằng requestAnimationFrame
        connection.on("ReceiveLiveFrame", function (data) {
            const userId = data.userId;
            const img = document.getElementById("video_" + userId);
            if (!img) return;

            // Sử dụng requestAnimationFrame để vẽ hình mượt hơn
            requestAnimationFrame(() => {
                let imageData = data.image;
                if (!imageData.startsWith("data:image"))
                    imageData = "data:image/jpeg;base64," + imageData;

                img.src = imageData;

                if (img.style.display === "none") {
                    img.style.display = "block";
                    document.getElementById("nosignal_" + userId).style.display = "none";
                    const status = document.getElementById("status_" + userId);
                    status.classList.replace("bg-secondary", "bg-success");
                    status.innerText = "LIVE";
                }
            });

            lastFrameTime[userId] = Date.now();
        });

        connection.on("ReceiveWarning", (data) => handleViolation(data.userId, data.message, data.risk, false));
        connection.on("ReceiveViolation", (data) => handleViolation(data.userId, data.message, data.riskScore || data.risk, true));

        function handleViolation(userId, message, risk, isLock) {
            const time = new Date().toLocaleTimeString();
            if (!violationHistory[userId]) violationHistory[userId] = [];
            violationHistory[userId].push({ message, risk, time });

            // Update Log UI
            const log = document.getElementById("violationLog");
            const div = document.createElement("div");
            div.className = "log-entry";
            div.innerHTML = `<b style="width:70px">${time}</b> <span style="width:100px; color:var(--s4-primary)">${userId}</span> <span>${message} (Risk: ${risk})</span>`;
            log.prepend(div);

            // Update Badge
            const badge = document.getElementById("risk_" + userId);
            if(badge) {
                badge.innerText = "R: " + risk;
                badge.className = "risk-badge " + (risk < 30 ? "risk-low" : risk < 70 ? "risk-medium" : "risk-high");
            }

            if(isLock && risk >= 150) {
                document.getElementById("locked_" + userId).style.display = "flex";
            }
        }

        function renderLoop() {
            const now = Date.now();
            document.querySelectorAll(".student-card").forEach(card => {
                const userId = card.dataset.userid;
                if (lastFrameTime[userId] && now - lastFrameTime[userId] > OFFLINE_TIMEOUT) {
                    setOffline(userId);
                }
            });

            const liveCount = document.querySelectorAll(".badge.bg-success").length;
            document.getElementById("liveCount").innerText = "LIVE: " + liveCount;

            setTimeout(() => requestAnimationFrame(renderLoop), 3000);
        }

        function setOffline(userId) {
            const img = document.getElementById("video_" + userId);
            if (img && img.style.display !== "none") {
                img.style.display = "none";
                document.getElementById("nosignal_" + userId).style.display = "block";
                const status = document.getElementById("status_" + userId);
                status.classList.replace("bg-success", "bg-secondary");
                status.innerText = "OFFLINE";
            }
        }

        function openHistory(userId) {
            document.getElementById("historyModal").style.display = "flex";
            document.getElementById("historyTitle").innerText = "Lịch sử: " + userId;
            const list = document.getElementById("historyList");
            const history = violationHistory[userId] || [];
            list.innerHTML = history.length ? history.map(h => `
                <div style="padding:10px; border-bottom:1px solid #eee; font-size:0.85rem">
                    <span class="text-muted">[${h.time}]</span> <b>${h.message}</b> - <span class="text-danger">Risk: ${h.risk}</span>
                </div>
            `).join('') : '<p class="text-center mt-3">Không có vi phạm</p>';
        }

        function closeHistory() { document.getElementById("historyModal").style.display = "none"; }
        function clearLog() { document.getElementById("violationLog").innerHTML = ""; }
    </script>
}