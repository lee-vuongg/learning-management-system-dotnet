﻿
@model LQV_BlockchainCertificate.Models.DBModel.LqvDiemDanhGp
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết điểm danh";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4 text-center">
                    <div class="mb-2">
                        @if (Model.LqvHopLe)
                        {
                            <i class="fas fa-check-circle fa-3x text-success"></i>
                        }
                        else
                        {
                            <i class="fas fa-times-circle fa-3x text-danger"></i>
                        }
                    </div>
                    <h4 class="fw-bold mb-0">Xác thực vị trí sinh viên</h4>
                </div>
                <div class="card-body p-4">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted fw-bold small text-uppercase">Mã sinh viên</span>
                            <span class="fw-bold fs-5">@Model.LqvSinhVienId</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted fw-bold small text-uppercase">Mã buổi học</span>
                            <span class="fw-bold">#@Model.LqvBuoiHocId</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted fw-bold small text-uppercase">Thời gian nhận diện</span>
                            <span class="text-dark fw-500">@Model.LqvThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted fw-bold small text-uppercase">Vĩ độ (Latitude)</span>
                            <code>@Model.LqvViDo</code>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                            <span class="text-muted fw-bold small text-uppercase">Kinh độ (Longitude)</span>
                            <code>@Model.LqvKinhDo</code>
                        </div>
                    </div>

                    <div class="mt-4 d-grid gap-2">
                        <a asp-action="Map" asp-route-buoiHocId="@Model.LqvBuoiHocId" class="btn btn-primary btn-lg rounded-3 fw-bold">
                            <i class="fas fa-map-marked-alt me-2"></i>Xem trên bản đồ buổi học
                        </a>
                        <a asp-action="Index" class="btn btn-light text-muted fw-bold rounded-3">Hủy và quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>