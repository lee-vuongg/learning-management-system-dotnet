@model LQV_BlockchainCertificate.Models.DBModel.LqvBaiTap
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Chi tiết bài tập";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="container">
    <div class="mb-4 d-flex align-items-center justify-content-between">
        <div>
            <a asp-action="Index" class="text-primary fw-bold text-decoration-none small"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
            <h3 class="fw-800 mt-2 mb-0">📘 Chi tiết bài tập</h3>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.LqvBaiTapId" class="btn btn-warning rounded-3 fw-bold px-4">
            <i class="fas fa-edit me-2"></i>Chỉnh sửa
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-primary mb-3">Nội dung bài tập</h5>
                <h4 class="fw-bold mb-3">@Model.LqvTieuDe</h4>
                <div class="p-4 bg-light rounded-3" style="min-height: 200px; white-space: pre-wrap;">
                    @Model.LqvMoTa
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold text-muted text-uppercase mb-3 small">Thông tin chung</h6>
                <div class="mb-3">
                    <label class="d-block small text-muted">Lớp học</label>
                    <span class="fw-bold text-dark">@Model.LqvLopHoc?.LqvTenLop</span>
                </div>
                <div class="mb-3">
                    <label class="d-block small text-muted">Hạn chót</label>
                    <span class="fw-bold text-danger"><i class="far fa-clock me-1"></i> @Model.LqvHanNop.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="mb-0">
                    <label class="d-block small text-muted">Trạng thái</label>
                    @if (Model.LqvTrangThai == "Mo")
                    {
                        <span class="badge bg-success rounded-pill px-3">Đang mở</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3">Đã đóng</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>