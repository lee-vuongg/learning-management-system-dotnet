﻿
@model IEnumerable<LQV_BlockchainCertificate.Models.DBModel.LqvDiemDanhGp>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Danh sách điểm danh";
    Layout = "~/Areas/GiangVien/Views/Shared/_GiangVienLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small fw-bold text-primary">
        <i class="fas fa-chevron-left"></i> QUAY LẠI
    </a>
    <h3 class="fw-800 mt-2">📊 Kết quả điểm danh GPS</h3>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th class="ps-4 py-3 border-0 text-muted small fw-bold">MÃ SINH VIÊN</th>
                <th class="border-0 text-muted small fw-bold">THỜI GIAN QUÉT</th>
                <th class="border-0 text-muted small fw-bold">TỌA ĐỘ THIẾT BỊ</th>
                <th class="border-0 text-muted small fw-bold text-center">TRẠNG THÁI</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4">
                        <div class="d-flex align-items-center">
                            <div class="avatar-sm bg-soft-primary text-primary rounded-circle me-3 d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                @(item.LqvSinhVienId.ToString().Substring(0, 1))
                            </div>
                            <span class="fw-bold">@item.LqvSinhVien.LqvHoTen</span>
                        </div>
                    </td>
                    <td class="text-muted">@item.LqvThoiGian.ToString("HH:mm:ss - dd/MM/yyyy")</td>
                    <td>
                        <span class="badge bg-light text-dark fw-500 border">@item.LqvViDo, @item.LqvKinhDo</span>
                    </td>
                    <td class="text-center">
                        @if (item.LqvHopLe)
                        {
                            <span class="badge rounded-pill bg-success px-3">Hợp lệ <i class="fas fa-check-circle ms-1"></i></span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-danger px-3">Ngoài vùng <i class="fas fa-times-circle ms-1"></i></span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>